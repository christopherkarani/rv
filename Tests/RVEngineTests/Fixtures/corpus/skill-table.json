    {
      "id": "skill.deny.reset-hard",
      "command": "git reset --hard",
      "expected": "deny",
      "rule_id": "core.git:reset-hard",
      "reason_contains": "destroys uncommitted changes"
    },
    {
      "id": "skill.deny.reset-hard-head",
      "command": "git reset --hard HEAD~1",
      "expected": "deny",
      "rule_id": "core.git:reset-hard",
      "reason_contains": "destroys uncommitted changes"
    },
    {
      "id": "skill.deny.reset-merge",
      "command": "git reset --merge",
      "expected": "deny",
      "rule_id": "core.git:reset-merge",
      "reason_contains": "can lose uncommitted changes"
    },
    {
      "id": "skill.deny.checkout-discard-dot",
