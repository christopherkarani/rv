      "reason_contains": "discards uncommitted changes"
    },
    {
      "id": "skill.deny.checkout-discard-file",
      "command": "git checkout -- file.txt",
      "expected": "deny",
      "rule_id": "core.git:checkout-discard",
      "reason_contains": "discards uncommitted changes"
    },
    {
      "id": "skill.deny.checkout-ref-discard",
      "command": "git checkout main -- file.txt",
      "expected": "deny",
      "rule_id": "core.git:checkout-ref-discard",
      "reason_contains": "overwrites working tree"
    },
    {
      "id": "skill.deny.restore-worktree",
      "command": "git restore file.txt",
      "expected": "deny",
      "rule_id": "core.git:restore-worktree",
      "reason_contains": "discards uncommitted changes"
    },
    {
      "id": "skill.deny.restore-worktree-long",
      "command": "git restore --worktree file.txt",
      "expected": "deny",
      "rule_id": "core.git:restore-worktree",
      "reason_contains": "discards uncommitted changes",
      "notes": "Source order first-matches restore-worktree; --worktree without --staged/-S never reaches restore-worktree-explicit."
    },
    {
      "id": "skill.deny.restore-worktree-short",
      "command": "git restore -W file.txt",
      "expected": "deny",
      "rule_id": "core.git:restore-worktree",
      "reason_contains": "discards uncommitted changes",
      "notes": "Same first-match as --worktree. restore-worktree-explicit is the -S -W / --staged --worktree row."
    },
    {
      "id": "skill.deny.restore-staged-and-worktree",
      "command": "git restore -S -W file.txt",
      "expected": "deny",
      "rule_id": "core.git:restore-worktree-explicit",
      "reason_contains": "discards uncommitted changes"
    },
