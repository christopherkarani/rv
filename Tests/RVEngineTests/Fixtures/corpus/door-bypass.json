{
  "schema_version": 1,
  "source": "door_bypass",
  "cases": [
    { "id": "db.deny.if-then-rm-home", "command": "if :; then rm -r ~; fi", "expected": "deny" },
    { "id": "db.deny.for-do-mv-ssh", "command": "for x in 1; do mv ~/.ssh /tmp; done", "expected": "deny" },
