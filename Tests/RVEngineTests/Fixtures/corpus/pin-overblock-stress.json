{
  "schema_version": 1,
  "source": "pin_overblock_stress",
  "cases": [
    {"id": "fp.search.awk-rm-rf", "command": "awk '/rm -rf/'", "expected": "allow"},
    {"id": "fp.search.awk-reset-hard", "command": "awk '/git reset --hard/'", "expected": "allow"},
    {"id": "fp.search.sed-reset-hard", "command": "sed -n '/git reset --hard/p'", "expected": "allow"},
    {"id": "fp.search.sed-rm-rf", "command": "sed -n '/rm -rf/p'", "expected": "allow"},
    {"id": "fp.search.perl-ne-rm-rf", "command": "perl -ne 'print if /rm -rf/'", "expected": "allow"},
    {"id": "fp.search.perl-e-reset", "command": "perl -e \"print 'git reset --hard'\"", "expected": "allow"},
    {"id": "fp.search.php-r-reset", "command": "php -r \"echo 'git reset --hard';\"", "expected": "allow"},
    {"id": "fp.search.lua-e-reset", "command": "lua -e \"print('git reset --hard')\"", "expected": "allow"},
    {"id": "fp.search.jq-n-reset", "command": "jq -n '\"git reset --hard\"'", "expected": "allow"},
    {"id": "fp.search.fgrep-rm-rf", "command": "fgrep 'rm -rf'", "expected": "allow"},
    {"id": "fp.search.egrep-rm-rf", "command": "egrep 'rm -rf'", "expected": "allow"},
    {"id": "fp.search.ag-rm-rf", "command": "ag 'rm -rf'", "expected": "allow"},
    {"id": "fp.git.pretty-format-reset", "command": "git show --pretty=format:'git reset --hard'", "expected": "allow"},
    {"id": "fp.git.log-pretty-reset", "command": "git log --pretty='git reset --hard'", "expected": "allow"},
    {"id": "fp.git.log-format-reset", "command": "git log --format='git reset --hard'", "expected": "allow"},
    {"id": "fp.git.for-each-ref-format", "command": "git for-each-ref --format='git reset --hard'", "expected": "allow"},
    {"id": "fp.git.commit-trailer-reset", "command": "git commit --trailer 'Made-with: git reset --hard'", "expected": "allow"},
    {"id": "fp.git.interpret-trailers-reset", "command": "git interpret-trailers --trailer 'Made-with: git reset --hard'", "expected": "allow"},
    {"id": "fp.git.config-alias-oops", "command": "git config alias.oops 'reset --hard'", "expected": "allow"},
    {"id": "fp.git.config-global-alias", "command": "git config --global alias.rh 'reset --hard'", "expected": "allow"},
    {"id": "fp.heredoc.write-reset", "command": "cat > /tmp/note.md << 'EOF'\nSee git reset --hard\nEOF", "expected": "allow"},
    {"id": "fp.heredoc.write-rm-rf", "command": "cat > /tmp/note.md << 'EOF'\nrm -rf /\nEOF", "expected": "allow"},
    {"id": "tp.canary.reset-hard", "command": "git reset --hard", "expected": "deny", "rule_id": "core.git:reset-hard"},
    {"id": "tp.canary.rm-rf-root", "command": "rm -rf /", "expected": "deny", "rule_id": "core.filesystem:rm-rf-root-home"},
    {"id": "tp.heredoc.pipe-bash-reset", "command": "cat <<'EOF' | bash\ngit reset --hard\nEOF", "expected": "deny", "rule_id": "core.git:reset-hard"}
