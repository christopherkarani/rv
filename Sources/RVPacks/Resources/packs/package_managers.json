{
  "schema_version": 1,
  "pin_version": "0.11.0",
  "id": "package_managers",
  "name": "Package Managers",
  "version": "0.11.0",
  "description": "Protects against dangerous package manager operations like publishing \\ packages and removing critical system packages",
  "category": "package_managers",
  "enabled_by_default": false,
  "keywords": [
    "npm",
    "yarn",
    "pnpm",
    "pip",
    "apt",
    "yum",
    "dnf",
    "cargo",
    "gem",
    "brew",
    "poetry",
    "mvn",
    "mvnw",
    "gradle",
    "gradlew",
    "publish"
  ],
  "safe_patterns": [
    {
      "name": "npm-install",
      "pattern": "\\bnpm\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+(?:install|i|ci)(?=\\s|$)",
      "description": ""
    },
    {
      "name": "yarn-add",
      "pattern": "\\byarn\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+(?:add|install)(?=\\s|$)",
      "description": ""
    },
    {
      "name": "pnpm-install",
      "pattern": "\\bpnpm\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+(?:add|install|i)(?=\\s|$)",
      "description": ""
    },
    {
      "name": "npm-list",
      "pattern": "\\bnpm\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+(?:list|ls|info|view)(?=\\s|$)",
      "description": ""
    },
    {
      "name": "yarn-list",
      "pattern": "\\byarn\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+(?:list|info|why)(?=\\s|$)",
      "description": ""
    },
    {
      "name": "npm-audit",
      "pattern": "\\bnpm\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+audit(?=\\s|$)",
      "description": ""
    },
    {
      "name": "yarn-audit",
      "pattern": "\\byarn\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+audit(?=\\s|$)",
      "description": ""
    },
    {
      "name": "pip-list",
      "pattern": "\\bpip\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+(?:list|show|freeze)(?=\\s|$)",
      "description": ""
    },
    {
      "name": "poetry-show",
      "pattern": "\\bpoetry\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+show(?=\\s|$)",
      "description": ""
    },
    {
      "name": "poetry-env-list",
      "pattern": "\\bpoetry\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+env\\s+list(?=\\s|$)",
      "description": ""
    },
    {
      "name": "cargo-safe",
      "pattern": "\\bcargo\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+(?:build|test|check|clippy|fmt|doc|bench)\\b",
      "description": ""
    },
    {
      "name": "apt-list",
      "pattern": "\\bapt\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+(?:list|show|search)(?=\\s|$)",
      "description": ""
    },
    {
      "name": "apt-get-list",
      "pattern": "\\bapt-get\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+(?:update|upgrade)(?!\\s+.*-y)",
      "description": ""
    },
    {
      "name": "npm-dry-run",
      "pattern": "\\bnpm\\b[^;|&\\n]*--dry-run(?:=true)?(?:\\s|$)",
      "description": ""
    },
    {
      "name": "yarn-dry-run",
      "pattern": "\\byarn\\b[^;|&\\n]*--dry-run(?:=true)?(?:\\s|$)",
      "description": ""
    },
    {
      "name": "pnpm-dry-run",
      "pattern": "\\bpnpm\\b[^;|&\\n]*--dry-run(?:=true)?(?:\\s|$)",
      "description": ""
    },
    {
      "name": "cargo-dry-run",
      "pattern": "\\bcargo\\b[^;|&\\n]*--dry-run(?:=true)?(?:\\s|$)",
      "description": ""
    },
    {
      "name": "poetry-dry-run",
      "pattern": "\\bpoetry\\b[^;|&\\n]*--dry-run(?:=true)?(?:\\s|$)",
      "description": ""
    }
  ],
  "destructive_patterns": [
    {
      "name": "npm-publish",
      "pattern": "\\bnpm(?:\\.(?:cmd|exe|com))?\\b(?:\\s+--?[^\\s;|&]+(?:\\s+(?!publish(?:[\\s;|&]|$))[^-\\s;|&][^\\s;|&]*)?)*\\s+publish(?=[\\s;|&]|$)(?![^;|&\\n]*--dry-run(?:=true)?(?:\\s|$))",
      "severity": "high",
      "description": "npm publish releases a package publicly. Use --dry-run first.",
      "examples": {
        "stop": [
          "npm publish"
        ],
        "allow": [
          "npm --help"
        ]
      }
    },
    {
      "name": "yarn-publish",
      "pattern": "\\byarn(?:\\.(?:cmd|exe|com))?\\b(?:\\s+(?:--?[^\\s;|&]+(?:\\s+(?!publish(?:[\\s;|&]|$))[^-\\s;|&][^\\s;|&]*)?|workspace\\s+[^\\s;|&]+|npm\\b))*\\s+publish(?=[\\s;|&]|$)(?![^;|&\\n]*--dry-run(?:=true)?(?:\\s|$))",
      "severity": "high",
      "description": "yarn publish releases a package publicly. Verify package.json first.",
      "examples": {
        "stop": [
          "yarn publish"
        ],
        "allow": [
          "yarn --help"
        ]
      }
    },
    {
      "name": "pnpm-publish",
      "pattern": "\\bpnpm(?:\\.(?:cmd|exe|com))?\\b(?:\\s+(?:--?[^\\s;|&]+(?:\\s+(?!publish(?:[\\s;|&]|$))[^-\\s;|&][^\\s;|&]*)?|recursive\\b))*\\s+publish(?=[\\s;|&]|$)(?![^;|&\\n]*--dry-run(?:=true)?(?:\\s|$))",
      "severity": "high",
      "description": "pnpm publish releases a package publicly.",
      "examples": {
        "stop": [
          "pnpm publish"
        ],
        "allow": [
          "pnpm --help"
        ]
      }
    },
    {
      "name": "npm-unpublish",
      "pattern": "\\bnpm\\b.*?\\bunpublish(?=\\s|$)",
      "severity": "high",
      "description": "npm unpublish removes a published package. This can break dependent projects.",
      "examples": {
        "stop": [
          "npm unpublish my-app"
        ],
        "allow": [
          "npm view my-app",
          "npm view"
        ]
      }
    },
    {
      "name": "pip-uninstall",
      "pattern": "\\bpip(?:3)?\\b.*?\\buninstall(?=\\s|$)",
      "severity": "high",
      "description": "pip uninstall removes installed packages. Verify dependencies before removing.",
      "examples": {
        "stop": [
          "pip uninstall my-app"
        ],
        "allow": [
          "pip list my-app",
          "pip status my-app"
        ]
      }
    },
    {
      "name": "pip-url",
      "pattern": "\\bpip\\b.*?\\binstall\\s+.*(?:https?://|git\\+)",
      "severity": "high",
      "description": "pip install from URL can install unvetted code. Verify the source first.",
      "examples": {
        "stop": [
          "pip install https:// git"
        ],
        "allow": [
          "pip --help"
        ]
      }
    },
    {
      "name": "pip-system",
      "pattern": "\\bpip\\b.*?\\binstall\\s+.*--(?:system|target\\s*/usr)",
      "severity": "high",
      "description": "pip install to system directories requires careful review.",
      "examples": {
        "stop": [
          "pip install --system target /usr"
        ],
        "allow": [
          "pip --help"
        ]
      }
    },
    {
      "name": "apt-remove",
      "pattern": "\\bapt(?:-get)?\\b.*?\\b(?:remove|purge|autoremove)(?=\\s|$)",
      "severity": "high",
      "description": "apt remove/purge removes packages. Verify no critical packages are affected.",
      "examples": {
        "stop": [
          "apt remove my-app"
        ],
        "allow": [
          "apt list my-app",
          "apt show my-app"
        ]
      }
    },
    {
      "name": "yum-remove",
      "pattern": "\\b(?:yum|dnf)\\b.*?\\b(?:remove|erase|autoremove)(?=\\s|$)",
      "severity": "high",
      "description": "yum/dnf remove removes packages. Verify no critical packages are affected.",
      "examples": {
        "stop": [
          "yum remove my-app"
        ],
        "allow": [
          "yum list my-app",
          "yum show my-app"
        ]
      }
    },
    {
      "name": "cargo-publish",
      "pattern": "\\bcargo\\b.*?\\bpublish\\b(?!.*--dry-run(?:=true)?(?:\\s|$))",
      "severity": "high",
      "description": "cargo publish releases a crate to crates.io. Use --dry-run first.",
      "examples": {
        "stop": [
          "cargo publish"
        ],
        "allow": [
          "cargo --help"
        ]
      }
    },
    {
      "name": "cargo-yank",
      "pattern": "\\bcargo\\b.*?\\byank(?=\\s|$)",
      "severity": "high",
      "description": "cargo yank marks a version as unavailable. This can break dependent projects.",
      "examples": {
        "stop": [
          "cargo yank"
        ],
        "allow": [
          "cargo --help"
        ]
      }
    },
    {
      "name": "gem-push",
      "pattern": "\\bgem\\b.*?\\bpush\\b",
      "severity": "high",
      "description": "gem push releases a gem to rubygems.org. Verify before publishing.",
      "examples": {
        "stop": [
          "gem push"
        ],
        "allow": [
          "gem --help"
        ]
      }
    },
    {
      "name": "brew-uninstall",
      "pattern": "\\bbrew\\b.*?\\b(?:uninstall|remove)(?=\\s|$)",
      "severity": "high",
      "description": "brew uninstall removes packages. Verify no dependent packages are affected.",
      "examples": {
        "stop": [
          "brew uninstall my-app"
        ],
        "allow": [
          "brew list my-app",
          "brew status my-app"
        ]
      }
    },
    {
      "name": "poetry-publish",
      "pattern": "\\bpoetry\\b.*?\\bpublish\\b(?!.*--dry-run(?:=true)?(?:\\s|$))",
      "severity": "high",
      "description": "poetry publish releases a package. Use --dry-run first.",
      "examples": {
        "stop": [
          "poetry publish"
        ],
        "allow": [
          "poetry --help"
        ]
      }
    },
    {
      "name": "poetry-remove",
      "pattern": "\\bpoetry\\b.*?\\bremove(?=\\s|$)",
      "severity": "high",
      "description": "poetry remove uninstalls a dependency. Verify no critical packages are affected.",
      "examples": {
        "stop": [
          "poetry remove my-app"
        ],
        "allow": [
          "poetry list my-app",
          "poetry show my-app"
        ]
      }
    },
    {
      "name": "maven-deploy",
      "pattern": "\\b(?:mvn|mvnw)\\b.*?\\bdeploy\\b",
      "severity": "high",
      "description": "mvn deploy publishes artifacts to a remote repository. Verify target repository.",
      "examples": {
        "stop": [
          "mvn deploy",
          "mvn clean deploy -DskipTests"
        ],
        "allow": [
          "mvn --help"
        ]
      }
    },
    {
      "name": "maven-release-perform",
      "pattern": "\\b(?:mvn|mvnw)\\s+.*release:perform\\b",
      "severity": "high",
      "description": "mvn release:perform publishes a release. Verify version and repository.",
      "examples": {
        "stop": [
          "mvn release:prepare release:perform",
          "mvn -B release:perform"
        ],
        "allow": [
          "mvn --help"
        ]
      }
    },
    {
      "name": "gradle-publish",
      "pattern": "\\b(?:gradle|gradlew)\\s+.*\\bpublish\\b",
      "severity": "high",
      "description": "gradle publish uploads artifacts. Use --dry-run first when possible.",
      "examples": {
        "stop": [
          "gradle publish"
        ],
        "allow": [
          "gradle --help"
        ]
      }
    }
  ]
}
