      "name": "diskutil-apfs-delete",
      "pattern": "(?i)diskutil\\s+(?:apfs|ap)\\s+(?:deleteContainer|deleteVolume|eraseVolume|deleteSnapshot)\\b",
      "severity": "critical",
      "description": "diskutil apfs delete/erase operations permanently remove APFS containers, volumes, or snapshots.",
      "explanation": "Deleting an APFS container destroys every volume inside it; deleting or erasing a volume destroys that volume's data; deleting a snapshot removes a restore point. None of these are recoverable without backups.\n\nList APFS structure first: diskutil apfs list",
      "safer_command": "diskutil apfs list",
      "examples": {
        "stop": [
          "diskutil apfs deleteVolume disk1s1"
