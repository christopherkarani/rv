{
  "schema_version": 1,
  "pin_version": "0.11.0",
  "id": "system.disk",
  "name": "Disk Operations",
  "version": "0.11.0",
  "description": "Protects against destructive disk operations like dd to devices, \\ mkfs, partition table modifications, RAID management, \\ btrfs/LVM/device-mapper operations, network block devices, \\ Linux drive erase/discard tools (blkdiscard, nvme, sg_format, hdparm, cryptsetup, ZFS), \\ and macOS diskutil erase/partition/APFS deletion",
  "category": "system",
  "enabled_by_default": true,
  "keywords": [
    "dd",
    "diskutil",
    "fdisk",
    "mkfs",
    "mkswap",
    "parted",
    "mount",
    "wipefs",
    "/dev/",
    "mdadm",
    "btrfs",
    "dmsetup",
    "nbd-client",
    "pvremove",
    "vgremove",
    "lvremove",
    "vgreduce",
    "lvreduce",
    "lvresize",
    "pvmove",
    "blkdiscard",
    "sgdisk",
    "sfdisk",
    "gdisk",
    "mke2fs",
    "mkntfs",
    "mkdosfs",
    "mkexfatfs",
    "nvme",
    "sg_format",
    "sg_sanitize",
    "hdparm",
    "cryptsetup",
    "ddrescue",
    "badblocks",
    "zpool",
    "zfs"
  ],
  "safe_patterns": [
    {
      "name": "dd-file-out",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?dd(?:\\s+(?!of=)[^\\s;&|]+)*\\s+of=['\\\"]?[^/\\s'\\\";&|]+\\.[^\\s;&|]*(?:\\s+(?!of=)[^\\s;&|]+)*\\s*(?=$|[;&|\\n])",
      "description": ""
    },
    {
      "name": "dd-discard",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?dd(?:\\s+(?!of=)[^\\s;&|]+)*\\s+of=['\\\"]?/dev/(?:null|zero|full)['\\\"]?(?:\\s+(?!of=)[^\\s;&|]+)*\\s*(?=$|[;&|\\n])",
      "description": ""
    },
    {
      "name": "lsblk",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?lsblk\\b",
      "description": ""
    },
    {
      "name": "fdisk-list",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?fdisk\\s+-l",
      "description": ""
    },
    {
      "name": "parted-print",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?parted\\b(?:\\s+--?\\S+)*\\s+(?:['\"]?/dev/\\S+['\"]?\\s+)?print(?:\\s+(?:devices|free|list|all|\\d+))?\\s*$",
      "description": ""
    },
    {
      "name": "blkid",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?blkid\\b",
      "description": ""
    },
    {
      "name": "df",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?df\\b",
      "description": ""
    },
    {
      "name": "mount-list",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?mount\\s*$",
      "description": ""
    },
    {
      "name": "mkswap-check",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?mkswap\\s+(?:.*\\s+)?--check\\b",
      "description": ""
    },
    {
      "name": "mdadm-detail",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?mdadm\\s+--detail\\b",
      "description": ""
    },
    {
      "name": "mdadm-examine",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?mdadm\\s+--examine\\b",
      "description": ""
    },
    {
      "name": "mdadm-query",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?mdadm\\s+--query\\b",
      "description": ""
    },
    {
      "name": "mdadm-query-short",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?mdadm\\s+-Q\\b",
      "description": ""
    },
    {
      "name": "mdadm-scan",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?mdadm\\s+--scan\\b",
      "description": ""
    },
    {
      "name": "btrfs-subvolume-list",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?btrfs\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+subvolume\\s+list(?=\\s|$)",
      "description": ""
    },
    {
      "name": "btrfs-subvolume-show",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?btrfs\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+subvolume\\s+show(?=\\s|$)",
      "description": ""
    },
    {
      "name": "btrfs-filesystem-show",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?btrfs\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+filesystem\\s+show(?=\\s|$)",
      "description": ""
    },
    {
      "name": "btrfs-filesystem-df",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?btrfs\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+filesystem\\s+df(?=\\s|$)",
      "description": ""
    },
    {
      "name": "btrfs-filesystem-usage",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?btrfs\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+filesystem\\s+usage(?=\\s|$)",
      "description": ""
    },
    {
      "name": "btrfs-device-stats",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?btrfs\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+device\\s+stats(?=\\s|$)",
      "description": ""
    },
    {
      "name": "btrfs-property-get",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?btrfs\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+property\\s+(?:get|list)(?=\\s|$)",
      "description": ""
    },
    {
      "name": "btrfs-scrub-status",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?btrfs\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+scrub\\s+status(?=\\s|$)",
      "description": ""
    },
    {
      "name": "dmsetup-ls",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?dmsetup\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+ls(?=\\s|$)",
      "description": ""
    },
    {
      "name": "dmsetup-status",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?dmsetup\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+status(?=\\s|$)",
      "description": ""
    },
    {
      "name": "dmsetup-info",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?dmsetup\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+info(?=\\s|$)",
      "description": ""
    },
    {
      "name": "dmsetup-table",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?dmsetup\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+table(?=\\s|$)",
      "description": ""
    },
    {
      "name": "dmsetup-deps",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?dmsetup\\b(?:\\s+--?\\S+(?:\\s+\\S+)?)*\\s+deps(?=\\s|$)",
      "description": ""
    },
    {
      "name": "nbd-client-list",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?nbd-client\\s+-l\\b",
      "description": ""
    },
    {
      "name": "nbd-client-check",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?nbd-client\\s+.*-check\\b",
      "description": ""
    },
    {
      "name": "diskutil-readonly",
      "pattern": "(?i)(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?diskutil\\s+(?:list|info|information|activity|listFilesystems|apfs\\s+list(?:Snapshots|Users)?)\\b[^;&|\\r\\n]*$",
      "description": ""
    },
    {
      "name": "lvm-list",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?(?:lvs|vgs|pvs)\\b",
      "description": ""
    },
    {
      "name": "lvm-display",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?(?:lvdisplay|vgdisplay|pvdisplay)\\b",
      "description": ""
    },
    {
      "name": "lvm-scan",
      "pattern": "(?:^|(?<![\\\\<>])[;&|\\n])\\s*(?:sudo\\s+)?(?:lvscan|vgscan|pvscan)\\b",
      "description": ""
    }
  ],
  "destructive_patterns": [
    {
      "name": "dd-device",
      "pattern": "dd\\s+.*of=['\"]?/dev/",
      "severity": "high",
      "description": "dd to a block device will OVERWRITE all data on that device. Extremely dangerous!",
      "safer_command": "lsblk -f",
      "examples": {
        "stop": [
          "dd of=/dev/sda"
        ],
        "allow": [
          "lsblk -f",
          "dd --help"
        ]
      }
    },
    {
      "name": "dd-wipe",
      "pattern": "dd\\s+.*if=['\"]?/dev/(?:zero|urandom|random).*of=['\"]?/dev/",
      "severity": "high",
      "description": "dd from /dev/zero or /dev/urandom to a device will WIPE all data!",
      "safer_command": "lsblk -f",
      "examples": {
        "stop": [
          "dd if=/dev/zero of=/dev/sdb bs=1M"
        ],
        "allow": [
          "lsblk -f",
          "dd --help"
        ]
      }
    },
    {
      "name": "fdisk-edit",
      "pattern": "fdisk\\s+['\"]?/dev/(?!.*-l)",
      "severity": "high",
      "description": "fdisk can modify partition tables and cause data loss.",
      "safer_command": "fdisk -l",
      "examples": {
        "stop": [
          "fdisk /dev/sdb"
        ],
        "allow": [
          "fdisk -l",
          "fdisk --help"
        ]
      }
    },
    {
      "name": "parted-modify",
      "pattern": "parted\\b[^\\n;&|]*?['\"]?/dev/\\S+['\"]?(?:\\s+--)?\\s+(?:(?!\\s*(?:align-check|help|h|print|p|quit|q|select|unit|u)\\b)|[^\\n;&|]*\\b(?:print|p)\\b\\s+(?:(?:devices|free|list|all|\\d+)\\s+\\S+|(?!devices\\b|free\\b|list\\b|all\\b|\\d+\\b)\\S+)|[^\\n;&|]*\\b(?:disk_set|disk_toggle|mklabel|mktable|mkpart|name|rescue|resizepart|rm|set|toggle|type)\\b)",
      "severity": "high",
      "description": "parted can modify partition tables and cause data loss.",
      "safer_command": "parted -l",
      "examples": {
        "stop": [
          "parted /dev/sdb rm 1",
          "parted /dev/sdb mklabel gpt"
        ],
        "allow": [
          "parted -l",
          "parted --help"
        ]
      }
    },
    {
      "name": "mkfs",
      "pattern": "mkfs(?:\\.[a-z0-9]+)?\\s+",
      "severity": "high",
      "description": "mkfs formats a partition/device and ERASES all existing data.",
      "safer_command": "lsblk -f",
      "examples": {
        "stop": [
          "mkfs.ext4 /dev/sdb1",
          "mkfs -t ext4 /dev/sdb1"
        ],
        "allow": [
          "lsblk -f",
          "mkfs --help"
        ]
      }
    },
    {
      "name": "mkswap",
      "pattern": "mkswap\\s+",
      "severity": "high",
      "description": "mkswap formats a partition as a swap area, ERASING any existing data.",
      "safer_command": "swapon --show",
      "examples": {
        "stop": [
          "mkswap /dev/sdb2"
        ],
        "allow": [
          "swapon --show",
          "mkswap --help"
        ]
      }
    },
    {
      "name": "wipefs",
      "pattern": "wipefs\\s+",
      "severity": "high",
      "description": "wipefs removes filesystem signatures. Use with extreme caution.",
      "safer_command": "lsblk -f",
      "examples": {
        "stop": [
          "wipefs -a /dev/sdb"
        ],
        "allow": [
          "lsblk -f",
          "wipefs --help"
        ]
      }
    },
    {
      "name": "mount-bind-root",
      "pattern": "mount\\s+.*--bind\\s+.*\\s+['\"]?/(?:$|[^a-z])",
      "severity": "high",
      "description": "mount --bind to root directory can have system-wide effects.",
      "safer_command": "findmnt",
      "examples": {
        "stop": [
          "mount --bind /mnt /"
        ],
        "allow": [
          "findmnt",
          "mount --help"
        ]
      }
    },
    {
      "name": "umount-force",
      "pattern": "umount\\s+.*-[a-z]*f",
      "severity": "high",
      "description": "umount -f force unmounts which may cause data loss if device is in use.",
      "safer_command": "findmnt",
      "examples": {
        "stop": [
          "umount -f /dev/sda"
        ],
        "allow": [
          "findmnt",
          "umount --help"
        ]
      }
    },
    {
      "name": "losetup-device",
      "pattern": "losetup\\s+['\"]?/dev/loop",
      "severity": "high",
      "description": "losetup modifies loop device associations. Verify before proceeding.",
      "safer_command": "losetup -l",
      "examples": {
        "stop": [
          "losetup /dev/loop0 disk.img"
        ],
        "allow": [
          "losetup -l",
          "losetup --help"
        ]
      }
    },
    {
      "name": "mdadm-stop",
      "pattern": "mdadm\\s+(?:.*\\s+)?(?:--stop|-S)\\b",
      "severity": "high",
      "description": "mdadm --stop shuts down a RAID array. Data may become inaccessible.",
      "safer_command": "cat /proc/mdstat",
      "examples": {
        "stop": [
          "mdadm --stop /dev/md0"
        ],
        "allow": [
          "cat /proc/mdstat",
          "mdadm --help"
        ]
      }
    },
    {
      "name": "mdadm-remove",
      "pattern": "mdadm\\s+(?:.*\\s+)?--remove\\b",
      "severity": "high",
      "description": "mdadm --remove removes a drive from a RAID array. May cause data loss if redundancy is lost.",
      "safer_command": "cat /proc/mdstat",
      "examples": {
        "stop": [
          "mdadm /dev/md0 --remove /dev/sdb1"
        ],
        "allow": [
          "cat /proc/mdstat",
          "mdadm --help"
        ]
      }
    },
    {
      "name": "mdadm-fail",
      "pattern": "mdadm\\s+(?:.*\\s+)?(?:--fail|-f)\\b",
      "severity": "high",
      "description": "mdadm --fail marks a device as failed. Use only for intentional drive replacement.",
      "safer_command": "cat /proc/mdstat",
      "examples": {
        "stop": [
          "mdadm /dev/md0 --fail /dev/sdb1"
        ],
        "allow": [
          "cat /proc/mdstat",
          "mdadm --help"
        ]
      }
    },
    {
      "name": "mdadm-zero-superblock",
      "pattern": "mdadm\\s+(?:.*\\s+)?--zero-superblock\\b",
      "severity": "high",
      "description": "mdadm --zero-superblock PERMANENTLY erases RAID metadata. Array cannot be reassembled.",
      "safer_command": "cat /proc/mdstat",
      "examples": {
        "stop": [
          "mdadm --zero-superblock /dev/sdb1"
        ],
        "allow": [
          "cat /proc/mdstat",
          "mdadm --help"
        ]
      }
    },
    {
      "name": "mdadm-create",
      "pattern": "mdadm\\s+(?:.*\\s+)?(?:--create|-C)\\b",
      "severity": "high",
      "description": "mdadm --create initializes a new RAID array, ERASING existing data on member devices.",
      "safer_command": "cat /proc/mdstat",
      "examples": {
        "stop": [
          "mdadm --create /dev/md0 --level=1 --raid-devices=2 /dev/sdb1 /dev/sdc1"
        ],
        "allow": [
          "cat /proc/mdstat",
          "mdadm --help"
        ]
      }
    },
    {
      "name": "mdadm-grow",
      "pattern": "mdadm\\s+(?:.*\\s+)?--grow\\b",
      "severity": "high",
      "description": "mdadm --grow reshapes a RAID array. Interruption can cause data loss. Backup first.",
      "safer_command": "cat /proc/mdstat",
      "examples": {
        "stop": [
          "mdadm --grow /dev/md0 --raid-devices=3"
        ],
        "allow": [
          "cat /proc/mdstat",
          "mdadm --help"
        ]
      }
    },
    {
      "name": "btrfs-subvolume-delete",
      "pattern": "btrfs\\b.*?\\s+subvolume\\s+delete\\b",
      "severity": "high",
      "description": "btrfs subvolume delete PERMANENTLY removes a subvolume and all its data.",
      "safer_command": "btrfs subvolume list /",
      "examples": {
        "stop": [
          "btrfs subvolume delete /mnt/data/snap"
        ],
        "allow": [
          "btrfs subvolume list /",
          "btrfs subvolume get /mnt/data/snap"
        ]
      }
    },
    {
      "name": "btrfs-device-remove",
      "pattern": "btrfs\\b.*?\\s+device\\s+(?:remove|delete)\\b",
      "severity": "high",
      "description": "btrfs device remove redistributes data off a device. Interruption causes data loss.",
      "safer_command": "btrfs filesystem show",
      "examples": {
        "stop": [
          "btrfs device remove /dev/sdc /mnt/data"
        ],
        "allow": [
          "btrfs filesystem show",
          "btrfs device list /dev/sdc /mnt/data"
        ]
      }
    },
    {
      "name": "btrfs-device-add",
      "pattern": "btrfs\\b.*?\\s+device\\s+add\\b",
      "severity": "high",
      "description": "btrfs device add incorporates a device into the filesystem. Verify the device is correct.",
      "safer_command": "btrfs filesystem show",
      "examples": {
        "stop": [
          "btrfs device add /dev/sdc /mnt/data"
        ],
        "allow": [
          "btrfs filesystem show",
          "btrfs --help"
        ]
      }
    },
    {
      "name": "btrfs-balance",
      "pattern": "btrfs\\b.*?\\s+balance\\s+start\\b",
      "severity": "high",
      "description": "btrfs balance redistributes data across devices. Can be slow and disruptive.",
      "safer_command": "btrfs filesystem show",
      "examples": {
        "stop": [
          "btrfs balance start /mnt/data"
        ],
        "allow": [
          "btrfs filesystem show",
          "btrfs --help"
        ]
      }
    },
    {
      "name": "btrfs-check-repair",
      "pattern": "btrfs\\b.*?\\s+check\\s+(?:.*\\s+)?--repair\\b",
      "severity": "high",
      "description": "btrfs check --repair is DANGEROUS and can cause data loss. Backup first!",
      "safer_command": "btrfs filesystem show",
      "examples": {
        "stop": [
          "btrfs check --repair /dev/sdb"
        ],
        "allow": [
          "btrfs filesystem show",
          "btrfs --help"
        ]
      }
    },
    {
      "name": "btrfs-rescue",
      "pattern": "btrfs\\b.*?\\s+rescue\\b",
      "severity": "high",
      "description": "btrfs rescue operations modify filesystem metadata. Use only as last resort.",
      "safer_command": "btrfs filesystem show",
      "examples": {
        "stop": [
          "btrfs rescue zero-log /dev/sdb"
        ],
        "allow": [
          "btrfs filesystem show",
          "btrfs --help"
        ]
      }
    },
    {
      "name": "btrfs-filesystem-resize",
      "pattern": "btrfs\\b.*?\\s+filesystem\\s+resize\\b",
      "severity": "high",
      "description": "btrfs filesystem resize can shrink a filesystem. Data loss if size is too small.",
      "safer_command": "btrfs filesystem show",
      "examples": {
        "stop": [
          "btrfs filesystem resize -10g /mnt/data"
        ],
        "allow": [
          "btrfs filesystem show",
          "btrfs --help"
        ]
      }
    },
    {
      "name": "dmsetup-remove",
      "pattern": "dmsetup\\b.*?\\s+remove\\b",
      "severity": "high",
      "description": "dmsetup remove detaches a device-mapper device. May cause data loss if in use.",
      "safer_command": "dmsetup ls",
      "examples": {
        "stop": [
          "dmsetup remove vg0-data"
        ],
        "allow": [
          "dmsetup ls",
          "dmsetup list vg0-data"
        ]
      }
    },
    {
      "name": "dmsetup-remove-all",
      "pattern": "dmsetup\\b.*?\\s+remove_all\\b",
      "severity": "high",
      "description": "dmsetup remove_all removes ALL device-mapper devices. Extremely dangerous!",
      "safer_command": "dmsetup ls",
      "examples": {
        "stop": [
          "dmsetup remove_all"
        ],
        "allow": [
          "dmsetup ls",
          "dmsetup --help"
        ]
      }
    },
    {
      "name": "dmsetup-wipe-table",
      "pattern": "dmsetup\\b.*?\\s+wipe_table\\b",
      "severity": "high",
      "description": "dmsetup wipe_table replaces the device table, causing all I/O to fail.",
      "safer_command": "dmsetup ls",
      "examples": {
        "stop": [
          "dmsetup wipe_table"
        ],
        "allow": [
          "dmsetup ls",
          "dmsetup --help"
        ]
      }
    },
    {
      "name": "dmsetup-clear",
      "pattern": "dmsetup\\b.*?\\s+clear\\b",
      "severity": "high",
      "description": "dmsetup clear removes the mapping table from a device.",
      "safer_command": "dmsetup ls",
      "examples": {
        "stop": [
          "dmsetup clear vg0-data"
        ],
        "allow": [
          "dmsetup ls",
          "dmsetup list vg0-data"
        ]
      }
    },
    {
      "name": "dmsetup-load",
      "pattern": "dmsetup\\b.*?\\s+load\\b",
      "severity": "high",
      "description": "dmsetup load changes device mapping. Verify the new table is correct.",
      "safer_command": "dmsetup ls",
      "examples": {
        "stop": [
          "dmsetup load vg0-data table.txt"
        ],
        "allow": [
          "dmsetup ls",
