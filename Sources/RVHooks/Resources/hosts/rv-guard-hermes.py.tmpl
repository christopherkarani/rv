"""RV destructive-command guard for Hermes terminal.

Registers ``pre_tool_call`` only. Deny is ``{"action": "block", "message"}``.
Ask is host confirm then PolicyGate spend; allow is None (the tool runs).
Never leftover host-gate approve as the allow path.
Missing rv / timeout / crash / non-JSON deny. Exceptions never escape — Hermes
isolates hook errors and would otherwise fail open.
"""

import json
import os
import subprocess
import uuid

RV_BINARY = "__RV_BINARY__"
RV_HOOK_TIMEOUT_S = 5


def register(ctx):
    ctx.register_hook("pre_tool_call", _on_pre_tool_call)


def _on_pre_tool_call(tool_name="", args=None, **kwargs):
    try:
        return _guard(tool_name, args, kwargs)
    except Exception:
        return {"action": "block", "message": "rv failed"}


def _guard(tool_name, args, kwargs):
    if tool_name != "terminal":
        return None
    payload = _envelope(tool_name, args, kwargs)
    mapped = _consult_rv(payload)
    if mapped["action"] == "ask":
        if not _confirm_ask(mapped):
            return {"action": "block", "message": mapped["reason"]}
        spent = _consult_rv_spend(payload)
        if spent["action"] != "allow":
            reason = spent.get("reason")
            if not isinstance(reason, str) or not reason:
                reason = mapped["reason"] if isinstance(mapped.get("reason"), str) else "rv failed"
            return {"action": "block", "message": reason}
        return None
    if mapped["action"] == "block":
        return {"action": "block", "message": mapped["reason"]}
    return None


def _confirm_ask(mapped):
    env = (os.environ.get("RV_ASK_CONFIRM") or "").strip().lower()
    if env == "yes":
        return True
    if env == "no":
        return False
    try:
        from tools.approval import request_tool_approval

        reason = mapped.get("reason")
        if not isinstance(reason, str) or not reason:
            reason = "Allow this command once?"
        result = request_tool_approval(
            "terminal",
            reason,
            rule_key="rv-ask:" + str(uuid.uuid4()),
        )
        return isinstance(result, dict) and result.get("approved") is True
    except Exception:
        return False


def _envelope(tool_name, args, kwargs):
    args = args if isinstance(args, dict) else {}
    command = args.get("command")
    workdir = args.get("workdir")
    cwd = _pick_cwd(workdir)
    session_id = kwargs.get("session_id")
    task_id = kwargs.get("task_id")
    payload = {"toolName": tool_name, "args": {}}
    if isinstance(command, str):
        payload["args"]["command"] = command
    if isinstance(workdir, str) and workdir:
        payload["args"]["workdir"] = workdir
    if cwd:
        payload["cwd"] = cwd
    if isinstance(session_id, str) and session_id:
        payload["sessionId"] = session_id
    if isinstance(task_id, str) and task_id:
        payload["taskId"] = task_id
    return payload


def _pick_cwd(host_cwd):
    if isinstance(host_cwd, str) and host_cwd:
        return host_cwd
    try:
        cwd = os.getcwd()
        if isinstance(cwd, str) and cwd:
            return cwd
    except Exception:
        pass
    return None


def _dumps(payload):
    return json.dumps(payload, separators=(",", ":"))


def _consult_rv(payload):
    return _spawn_rv_hook("hermes", _dumps(payload))


def _consult_rv_spend(payload):
    spend = dict(payload)
    spend["hostAsk"] = "spend"
    return _spawn_rv_hook("hermes", _dumps(spend))


def _spawn_rv_hook(host, stdin):
    try:
        completed = subprocess.run(
            [RV_BINARY, "hook", "--host", host],
            input=stdin,
            capture_output=True,
            text=True,
            timeout=RV_HOOK_TIMEOUT_S,
        )
    except FileNotFoundError:
        return {"action": "block", "reason": "rv missing"}
    except (OSError, subprocess.TimeoutExpired):
        return {"action": "block", "reason": "rv failed"}
    return _map_rv_hook_result(completed.stdout, completed.returncode)


def _map_rv_hook_result(stdout, exit_code):
    trimmed = (stdout or "").strip()
    if trimmed:
        try:
            parsed = json.loads(trimmed)
            if isinstance(parsed, dict) and parsed.get("decision") == "ask":
                reason = parsed.get("reason")
                return {
                    "action": "ask",
                    "reason": reason if isinstance(reason, str) else "",
                }
            if isinstance(parsed, dict) and parsed.get("decision") == "deny":
                reason = parsed.get("reason")
                return {
                    "action": "block",
                    "reason": reason if isinstance(reason, str) else "",
                }
        except (ValueError, TypeError):
            pass
        return {"action": "block", "reason": "rv failed"}
    if exit_code == 0:
        return {"action": "allow"}
    return {"action": "block", "reason": "rv failed"}
