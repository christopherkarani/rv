import { spawn } from "node:child_process";

const RV_BINARY = "__RV_BINARY__";
const RV_HOOK_TIMEOUT_MS = 5000;
const RV_TOAST_TIMEOUT_MS = 1500;
const RV_TOAST_TITLE = "RV · Blocked";
const RV_CMD_PREVIEW = 96;
const RV_MISSING_COMMAND =
  "rv received a shell hook with no command text and blocked the command. Run it in Terminal.";
const RV_ASK_TIMEOUT_MS = 120000;

const gatedCallIDs = new Set();
const officialPermissionReplies = new Map();

export const RvGuard = async (ctx) => {
  listenOfficialPermissionBus(ctx);
  return {
    event: async (input) => {
      rememberOfficialPermissionReply(input && input.event);
    },
    "tool.execute.before": async (input, output) => {
      if (!isShellTool(input && input.tool)) {
        return;
      }
      const command = commandFromTool(input, output);
      if (!command) {
        await failClosed(ctx, { action: "block", reason: RV_MISSING_COMMAND }, "");
      }
      await gateCommand(ctx, input, output, command, input.tool);
      rememberGated(input && input.callID);
    },
    "shell.env": async (input, output) => {
      if (isGated(input && input.callID)) {
        return;
      }
      const command =
        commandFromShellEnv(input, output) ?? (await commandFromSession(ctx, input));
      if (!command) {
        await failClosed(ctx, { action: "block", reason: RV_MISSING_COMMAND }, "");
      }
      await gateCommand(ctx, input, output, command, "session.shell");
      rememberGated(input && input.callID);
    },
  };
};

function isShellTool(tool) {
  return tool === "bash" || tool === "session.shell";
}

function stringCommand(value) {
  return typeof value === "string" && value.length > 0 ? value : undefined;
}

function commandFromRecord(record) {
  if (!record || typeof record !== "object") {
    return undefined;
  }
  return (
    stringCommand(record.command) ??
    stringCommand(record.cmd) ??
    commandFromRecord(record.args) ??
    commandFromRecord(record.input) ??
    commandFromRecord(record.state && record.state.input)
  );
}

function commandFromTool(input, output) {
  return commandFromRecord(output && output.args) ?? commandFromRecord(input);
}

function commandFromShellEnv(input, output) {
  return commandFromRecord(input) ?? commandFromRecord(output);
}

async function commandFromSession(ctx, input) {
  const sessionID = stringCommand(input && input.sessionID);
  const callID = stringCommand(input && input.callID);
  const session = ctx && ctx.client && ctx.client.session;
  if (!sessionID || !callID || !session || typeof session.messages !== "function") {
    return undefined;
  }
  let result;
  try {
    result = await session.messages({
      sessionID,
      path: { id: sessionID },
    });
  } catch {
    return undefined;
  }
  const matches = [];
  collectPartCommands(result, matches, 0);
  const exact = matches.find((row) => row.callID === callID);
  return exact && exact.command;
}

function collectPartCommands(value, acc, depth) {
  if (depth > 10 || value == null) {
    return;
  }
  if (Array.isArray(value)) {
    for (const item of value) {
      collectPartCommands(item, acc, depth + 1);
    }
    return;
  }
  if (typeof value !== "object") {
    return;
  }
  const tool = value.tool ?? value.toolName;
  const callID = stringCommand(value.callID ?? value.callId);
  if (isShellTool(tool) && callID) {
    const command =
      commandFromRecord(value.state && value.state.input) ??
      commandFromRecord(value.input) ??
      commandFromRecord(value.args) ??
      stringCommand(value.command);
    if (command) {
      acc.push({ callID, command });
    }
  }
  if (value.parts) {
    collectPartCommands(value.parts, acc, depth + 1);
  }
  if (value.data) {
    collectPartCommands(value.data, acc, depth + 1);
  }
  if (value.messages) {
    collectPartCommands(value.messages, acc, depth + 1);
  }
}

function rememberGated(callID) {
  if (typeof callID === "string" && callID.length > 0) {
    gatedCallIDs.add(callID);
  }
}

function isGated(callID) {
  return typeof callID === "string" && gatedCallIDs.has(callID);
}

async function failClosed(ctx, mapped, command) {
  await showBlockToast(ctx, mapped, command);
  throw new Error(
    typeof mapped.reason === "string" && mapped.reason.length > 0
      ? mapped.reason
      : RV_MISSING_COMMAND,
  );
}

async function gateCommand(ctx, input, output, command, tool) {
  const hostCwd =
    typeof input.cwd === "string"
      ? input.cwd
      : typeof input.directory === "string"
        ? input.directory
        : undefined;
  const cwd = pickCwd(hostCwd);
  const mapped = await consultRv(command, cwd, tool);
  if (mapped.action === "ask") {
    const allowed = await confirmAsk(ctx, input, mapped, command);
    if (!allowed) {
      await failClosed(ctx, mapped, command);
    }
    const spent = await consultRvSpend(command, cwd, tool);
    if (spent.action !== "allow") {
      const blocked = spent.action === "block" || spent.action === "ask" ? spent : mapped;
      await failClosed(ctx, blocked.reason ? blocked : mapped, command);
    }
    return;
  }
  if (mapped.action === "block") {
    await failClosed(ctx, mapped, command);
  }
}

async function confirmAsk(ctx, input, mapped, command) {
  try {
    if (ctx?.ui?.hasUI === false) {
      return false;
    }
    return await confirmOfficialPermission(ctx, input, mapped, command);
  } catch {
    return false;
  }
}

async function confirmOfficialPermission(ctx, input, mapped, command) {
  const sessionID = stringCommand(input && input.sessionID);
  if (!sessionID) {
    return false;
  }
  // Official 1.18.18 tools paint host PermissionPrompt via Tool.Context
  // ctx.ask during tool execute (shell.ts / webfetch / external-directory).
  // That is V1 Permission.ask → V1 asked event → TUI sync store.
  // Return is host permission.tsx → Permission.reply → V1 replied event.
  // Plugin cannot call ctx.ask. session.permission.create is V2 and
  // does not fill that store. Leftover unused V1 replied on a V2 create
  // id is not a permit. Smallest official hook: plugin-callable
  // Permission.ask, or TUI adaptServerEvent for V2 asked, plus a
  // post-Return spend hook. Factory forbids leftover-ask-as-permit.
  // Create first. Live 1.18.18 SDK subscribe can throw or omit a stream;
  // dying before create leaves no permission, so host PermissionPrompt never paints.
  const created = await createOfficialPermission(ctx, sessionID, input, mapped, command);
  if (!created || created.effect === "deny" || created.effect === "allow") {
    return false;
  }
  if (created.effect !== "ask" || !created.id) {
    return false;
  }
  return await Promise.race([
    waitOfficialPermissionReply(ctx, created.id, sessionID),
    new Promise((resolve) => {
      setTimeout(() => resolve(false), RV_ASK_TIMEOUT_MS);
    }),
  ]);
}

async function waitOfficialPermissionReply(ctx, requestID, sessionID) {
  const remembered = waitRememberedOfficialReply(sessionID, requestID);
  const stream = await officialPermissionStream(ctx);
  if (!stream) {
    return await remembered;
  }
  const fromStream = readOfficialPermissionReply(stream, requestID, sessionID).then((reply) => {
    if (reply === undefined) {
      return remembered;
    }
    return reply === "once" || reply === "always";
  });
  return await Promise.race([remembered, fromStream]);
}

async function officialPermissionStream(ctx) {
  const candidates = [
    ctx && ctx.client && ctx.client.v2 && ctx.client.v2.event && ctx.client.v2.event.subscribe,
    ctx && ctx.client && ctx.client.event && ctx.client.event.subscribe,
  ];
  for (const subscribe of candidates) {
    if (typeof subscribe !== "function") {
      continue;
    }
    try {
      const stream = permissionEventStream(await subscribe());
      if (stream) {
        return stream;
      }
    } catch {
      // Official live SSE can throw; Hooks.event still observes reply 204.
    }
  }
  return undefined;
}

function listenOfficialPermissionBus(ctx) {
  const on = ctx && ctx.event && ctx.event.on;
  if (typeof on !== "function") {
    return;
  }
  const replied = "permission.v2.replied";
  on(replied, (event) => rememberOfficialPermissionReply(event));
}

function officialReplyKey(sessionID, requestID) {
  return `${sessionID}\0${requestID}`;
}

function rememberOfficialPermissionReply(event) {
  if (!event || typeof event !== "object") {
    return;
  }
  if (event.data && typeof event.data === "object" && event.data.type) {
    rememberOfficialPermissionReply(event.data);
    return;
  }
  const replied = "permission.v2.replied";
  if (event.type !== replied) {
    return;
  }
  const props = event.properties ?? event.data ?? {};
  const requestID = stringCommand(props.requestID ?? props.id);
  if (!requestID) {
    return;
  }
  const sessionID = stringCommand(props.sessionID) ?? "";
  const reply = typeof props.reply === "string" ? props.reply : undefined;
  if (!reply) {
    return;
  }
  const key = officialReplyKey(sessionID, requestID);
  const current = officialPermissionReplies.get(key);
  if (current && typeof current.resolve === "function") {
    current.resolve(reply);
  }
  officialPermissionReplies.set(key, { reply });
}

function waitRememberedOfficialReply(sessionID, requestID) {
  const exact = officialReplyKey(sessionID, requestID);
  const current = officialPermissionReplies.get(exact);
  if (current && typeof current.reply === "string") {
    return Promise.resolve(current.reply === "once" || current.reply === "always");
  }
  return new Promise((resolve) => {
    officialPermissionReplies.set(exact, {
      resolve: (reply) => {
        resolve(reply === "once" || reply === "always");
      },
    });
  });
}

async function createOfficialPermission(ctx, sessionID, input, mapped, command) {
  const body = {
    // Default build agent is `*: allow`. Unmatched "rv" is leftover-ask-as-permit
    // (immediate allow). `external_directory` last-matches ask on 1.18.18.
    action: "external_directory",
    resources: ["/rv-ask"],
    metadata: {
      rv: true,
      command,
      reason: typeof mapped.reason === "string" ? mapped.reason : "",
    },
  };
  const callID = stringCommand(input && input.callID);
  const messageID = stringCommand(input && input.messageID);
  if (callID && messageID) {
    body.source = { type: "tool", messageID, callID };
  }
  const session = ctx && ctx.client && ctx.client.session;
  const create =
    (session && session.permission && session.permission.create) ??
    (ctx && ctx.client && ctx.client.permission && ctx.client.permission.create) ??
    (ctx &&
      ctx.client &&
      ctx.client.v2 &&
      ctx.client.v2.session &&
      ctx.client.v2.session.permission &&
      ctx.client.v2.session.permission.create);
  if (typeof create !== "function") {
    return undefined;
  }
  return unwrapPermissionCreate(
    await create({
      ...body,
      sessionID,
      path: { sessionID, id: sessionID },
    }),
  );
}

function unwrapPermissionCreate(value) {
  if (!value || typeof value !== "object") {
    return undefined;
  }
  const row = value.data && typeof value.data === "object" ? value.data : value;
  const inner = row.data && typeof row.data === "object" && row.id == null ? row.data : row;
  const id = stringCommand(inner.id);
  const effect = typeof inner.effect === "string" ? inner.effect : undefined;
  const reply = typeof inner.reply === "string" ? inner.reply : undefined;
  if (!id && !effect && !reply) {
    return undefined;
  }
  return { id, effect, reply };
}

function permissionEventStream(sub) {
  if (!sub) {
    return undefined;
  }
  if (typeof sub[Symbol.asyncIterator] === "function") {
    return sub;
  }
  if (sub.stream && typeof sub.stream[Symbol.asyncIterator] === "function") {
    return sub.stream;
  }
  if (sub.data && typeof sub.data[Symbol.asyncIterator] === "function") {
    return sub.data;
  }
  return undefined;
}

async function readOfficialPermissionReply(stream, requestID, sessionID) {
  for await (const event of stream) {
    const reply = permissionReplyFromEvent(event, requestID, sessionID);
    if (reply === undefined) {
      continue;
    }
    return reply;
  }
  return undefined;
}

function permissionReplyFromEvent(event, requestID, sessionID) {
  if (!event || typeof event !== "object") {
    return undefined;
  }
  if (event.data && typeof event.data === "object" && event.data.type) {
    return permissionReplyFromEvent(event.data, requestID, sessionID);
  }
  const replied = "permission.v2.replied";
  if (event.type !== replied) {
    return undefined;
  }
  const props = event.properties ?? event.data ?? {};
  const id = stringCommand(props.requestID ?? props.id);
  if (id !== requestID) {
    return undefined;
  }
  const session = stringCommand(props.sessionID);
  if (session && session !== sessionID) {
    return undefined;
  }
  return typeof props.reply === "string" ? props.reply : undefined;
}

function pickCwd(hostCwd) {
  if (typeof hostCwd === "string" && hostCwd.length > 0) return hostCwd;
  try {
    const cwd = process.cwd();
    if (typeof cwd === "string" && cwd.length > 0) return cwd;
  } catch {
    // omit
  }
  return undefined;
}

function consultRv(command, cwd, tool) {
  const payload = { tool: wireTool(tool), args: { command } };
  if (cwd) payload.cwd = cwd;
  return spawnRvHook("opencode", JSON.stringify(payload));
}

function consultRvSpend(command, cwd, tool) {
  const payload = { tool: wireTool(tool), args: { command }, hostAsk: "spend" };
  if (cwd) payload.cwd = cwd;
  return spawnRvHook("opencode", JSON.stringify(payload));
}

function wireTool(tool) {
  return tool === "session.shell" ? "session.shell" : "bash";
}

function spawnRvHook(host, stdin) {
  return new Promise((resolve) => {
    let settled = false;
    const done = (value) => {
      if (settled) {
        return;
      }
      settled = true;
      resolve(mapRvHookResult(value));
    };

    let child;
    try {
      child = spawn(RV_BINARY, ["hook", "--host", host], {
        stdio: ["pipe", "pipe", "pipe"],
      });
    } catch (error) {
      done({ error });
      return;
    }

    const chunks = [];
    child.stdout.on("data", (chunk) => {
      chunks.push(chunk);
    });
    child.on("error", (error) => {
      done({ error });
    });

    const timer = setTimeout(() => {
      child.kill("SIGKILL");
      done({ timedOut: true });
    }, RV_HOOK_TIMEOUT_MS);

    child.on("close", (code) => {
      clearTimeout(timer);
      done({
        stdout: Buffer.concat(chunks).toString("utf8"),
        exitCode: code,
      });
    });

    try {
      child.stdin.end(stdin, "utf8");
    } catch (error) {
      done({ error });
    }
  });
}

function mapRvHookResult(value) {
  if (value.error && value.error.code === "ENOENT") {
    return { action: "block", reason: "rv missing" };
  }
  if (value.error || value.timedOut) {
    return { action: "block", reason: "rv failed" };
  }
  const stdout = value.stdout ?? "";
  const trimmed = stdout.trim();
  if (trimmed.length > 0) {
    try {
      const parsed = JSON.parse(trimmed);
      if (parsed && parsed.decision === "ask") {
        return {
          action: "ask",
          reason: typeof parsed.reason === "string" ? parsed.reason : "",
          rule: typeof parsed.rule === "string" ? parsed.rule : undefined,
          next: typeof parsed.next === "string" ? parsed.next : undefined,
        };
      }
      if (parsed && parsed.decision === "deny") {
        const unlockable = typeof parsed.rule === "string" && parsed.rule.length > 0;
        return {
          action: unlockable ? "ask" : "block",
          reason: typeof parsed.reason === "string" ? parsed.reason : "",
          rule: typeof parsed.rule === "string" ? parsed.rule : undefined,
          next: typeof parsed.next === "string" ? parsed.next : undefined,
        };
      }
    } catch {
      // non-JSON from a started rv is a failure, not allow
    }
    return { action: "block", reason: "rv failed" };
  }
  if (value.exitCode === 0) {
    return { action: "allow" };
  }
  return { action: "block", reason: "rv failed" };
}

function formatToastMessage(mapped, command) {
  const card = cardFromBlock(mapped, command);
  const lines = [];
  const push = (label, value) => {
    if (!value) {
      return;
    }
    lines.push(`${label.padEnd(4)}  ${value}`);
  };
  push("Why", card.summary);
  push("Cmd", card.preview);
  push("Meta", card.rule);
  push("Next", card.nextStep);
  return lines.join("\n").slice(0, 280);
}

function cardFromBlock(mapped, command) {
  const preview = previewCommand(command);
  if (typeof mapped.rule === "string" || typeof mapped.next === "string") {
    let summary = typeof mapped.reason === "string" ? mapped.reason : "";
    if (typeof mapped.rule === "string") {
      summary = summary.split(` (${mapped.rule})`).join("");
    }
    if (typeof mapped.next === "string") {
      summary = summary.split(`. ${mapped.next}`).join("");
    }
    return {
      summary: sanitizeVisibleText(summary) || "Blocked.",
      rule: typeof mapped.rule === "string" ? mapped.rule : undefined,
      nextStep: typeof mapped.next === "string" ? mapped.next : undefined,
      preview,
    };
  }
  return cardFromReason(mapped.reason, preview);
}

function cardFromReason(reason, preview) {
  const cleaned = sanitizeVisibleText(typeof reason === "string" ? reason : "");
  const withRule = cleaned.match(/^(.+?) \(([^)]+)\)\.\s*(.+)$/);
  if (withRule) {
    return {
      summary: withRule[1],
      rule: withRule[2],
      nextStep: withRule[3],
      preview,
    };
  }
  const withNext = cleaned.match(/^(.+?)\.\s+(.+)$/);
  if (withNext) {
    return {
      summary: withNext[1],
      nextStep: withNext[2],
      preview,
    };
  }
  return {
    summary: cleaned || "Blocked.",
    preview,
  };
}

function sanitizeVisibleText(value) {
  return String(value ?? "")
    .replace(/\s+/g, " ")
    .trim();
}

function previewCommand(command) {
  const text = sanitizeVisibleText(command);
  if (text.length <= RV_CMD_PREVIEW) {
    return text;
  }
  return `${text.slice(0, RV_CMD_PREVIEW - 3)}...`;
}

async function showBlockToast(ctx, mapped, command) {
  const payload = {
    title: RV_TOAST_TITLE,
    message: formatToastMessage(mapped, command),
    variant: "error",
    duration: 8000,
  };
  const toastPromise = invokeShowToast(ctx, payload);
  void toastPromise.catch(() => undefined);
  let timer;
  try {
    await Promise.race([
      toastPromise,
      new Promise((_, reject) => {
        timer = setTimeout(() => reject(new Error("toast timeout")), RV_TOAST_TIMEOUT_MS);
      }),
    ]);
  } catch {
    // Chrome failed; tool.execute.before still throws.
  } finally {
    if (timer !== undefined) {
      clearTimeout(timer);
    }
  }
}

async function invokeShowToast(ctx, payload) {
  const tui = ctx && ctx.client && ctx.client.tui;
  if (!tui) {
    return;
  }
  const showToast =
    typeof tui.showToast === "function" ? tui.showToast.bind(tui) : undefined;
  if (typeof showToast !== "function") {
    return;
  }
  try {
    const wrapped = await showToast({ body: payload });
    if (wrapped && wrapped.error) {
      await showToast(payload);
    }
  } catch {
    await showToast(payload);
  }
}
