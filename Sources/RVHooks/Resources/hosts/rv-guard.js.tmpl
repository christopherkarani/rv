import { spawn } from "node:child_process";

const RV_BINARY = "__RV_BINARY__";
const RV_HOOK_TIMEOUT_MS = 5000;
const RV_TOAST_TIMEOUT_MS = 1500;
const RV_TOAST_TITLE = "RV · Blocked";
const RV_CMD_PREVIEW = 96;
const RV_MISSING_COMMAND =
  "rv received a shell hook with no command text and blocked the command. Run it in Terminal.";

const gatedCallIDs = new Set();

export const RvGuard = async (ctx) => {
  return {
    "tool.execute.before": async (input, output) => {
      if (!isShellTool(input && input.tool)) {
        return;
      }
      const command = commandFromTool(input, output);
      if (!command) {
        await failClosed(ctx, { action: "block", reason: RV_MISSING_COMMAND }, "");
      }
      await gateCommand(ctx, input, output, command, input.tool);
      rememberGated(input && input.callID);
    },
    "shell.env": async (input, output) => {
      if (isGated(input && input.callID)) {
        return;
      }
      const command =
        commandFromShellEnv(input, output) ?? (await commandFromSession(ctx, input));
      if (!command) {
        await failClosed(ctx, { action: "block", reason: RV_MISSING_COMMAND }, "");
      }
      await gateCommand(ctx, input, output, command, "session.shell");
      rememberGated(input && input.callID);
    },
  };
};

function isShellTool(tool) {
  return tool === "bash" || tool === "session.shell";
}

function stringCommand(value) {
  return typeof value === "string" && value.length > 0 ? value : undefined;
}

function commandFromRecord(record) {
  if (!record || typeof record !== "object") {
    return undefined;
  }
  return (
    stringCommand(record.command) ??
    stringCommand(record.cmd) ??
    commandFromRecord(record.args) ??
    commandFromRecord(record.input) ??
    commandFromRecord(record.state && record.state.input)
  );
}

function commandFromTool(input, output) {
  return commandFromRecord(output && output.args) ?? commandFromRecord(input);
}

function commandFromShellEnv(input, output) {
  return commandFromRecord(input) ?? commandFromRecord(output);
}

async function commandFromSession(ctx, input) {
  const sessionID = stringCommand(input && input.sessionID);
  const session = ctx && ctx.client && ctx.client.session;
  if (!sessionID || !session || typeof session.messages !== "function") {
    return undefined;
  }
  let result;
  try {
    result = await session.messages({
      sessionID,
      path: { id: sessionID },
    });
  } catch {
    return undefined;
  }
  const matches = [];
  collectPartCommands(result, matches, 0);
  const callID = stringCommand(input && input.callID);
  if (callID) {
    const exact = matches.find((row) => row.callID === callID);
    if (exact) {
      return exact.command;
    }
  }
  const last = matches[matches.length - 1];
  return last && last.command;
}

function collectPartCommands(value, acc, depth) {
  if (depth > 10 || value == null) {
    return;
  }
  if (Array.isArray(value)) {
    for (const item of value) {
      collectPartCommands(item, acc, depth + 1);
    }
    return;
  }
  if (typeof value !== "object") {
    return;
  }
  const command =
    commandFromRecord(value.state && value.state.input) ??
    commandFromRecord(value.input) ??
    commandFromRecord(value.args) ??
    stringCommand(value.command);
  const tool = value.tool ?? value.toolName;
  const callID = value.callID ?? value.callId;
  if (command && (tool == null || isShellTool(tool) || value.type === "tool")) {
    acc.push({ callID, command });
  }
  if (value.parts) {
    collectPartCommands(value.parts, acc, depth + 1);
  }
  if (value.data) {
    collectPartCommands(value.data, acc, depth + 1);
  }
  if (value.messages) {
    collectPartCommands(value.messages, acc, depth + 1);
  }
}

function rememberGated(callID) {
  if (typeof callID === "string" && callID.length > 0) {
    gatedCallIDs.add(callID);
  }
}

function isGated(callID) {
  return typeof callID === "string" && gatedCallIDs.has(callID);
}

async function failClosed(ctx, mapped, command) {
  await showBlockToast(ctx, mapped, command);
  throw new Error(
    typeof mapped.reason === "string" && mapped.reason.length > 0
      ? mapped.reason
      : RV_MISSING_COMMAND,
  );
}

async function gateCommand(ctx, input, output, command, tool) {
  const hostCwd =
    typeof input.cwd === "string"
      ? input.cwd
      : typeof input.directory === "string"
        ? input.directory
        : undefined;
  const cwd = pickCwd(hostCwd);
  const mapped = await consultRv(command, cwd, tool);
  if (mapped.action === "ask") {
    const allowed = await confirmAsk(ctx, input, output, mapped);
    if (!allowed) {
      await failClosed(ctx, mapped, command);
    }
    const spent = await consultRvSpend(command, cwd, tool);
    if (spent.action !== "allow") {
      const blocked = spent.action === "block" || spent.action === "ask" ? spent : mapped;
      await failClosed(ctx, blocked.reason ? blocked : mapped, command);
    }
    return;
  }
  if (mapped.action === "block") {
    await failClosed(ctx, mapped, command);
  }
}

async function confirmAsk(ctx, input, output, mapped) {
  try {
    if (ctx?.ui?.hasUI === false) {
      return false;
    }
    const prompt = {
      message:
        typeof mapped.reason === "string" && mapped.reason.length > 0
          ? mapped.reason
          : "Allow this command once?",
    };
    const askers = [input?.ask, output?.onResolution, ctx?.ask, ctx?.ui?.confirm];
    for (const ask of askers) {
      if (typeof ask !== "function") {
        continue;
      }
      return isAllowOnceResolution(await ask(prompt));
    }
    return false;
  } catch {
    return false;
  }
}

function isAllowOnceResolution(value) {
  if (value === true) {
    return true;
  }
  if (value === "once" || value === "allow-once" || value === "allowOnce") {
    return true;
  }
  if (value && typeof value === "object") {
    const status = value.status ?? value.decision ?? value.effect ?? value.action;
    if (
      status === true ||
      status === "once" ||
      status === "allow-once" ||
      status === "allowOnce" ||
      status === "allow"
    ) {
      return true;
    }
  }
  return false;
}

function pickCwd(hostCwd) {
  if (typeof hostCwd === "string" && hostCwd.length > 0) return hostCwd;
  try {
    const cwd = process.cwd();
    if (typeof cwd === "string" && cwd.length > 0) return cwd;
  } catch {
    // omit
  }
  return undefined;
}

function consultRv(command, cwd, tool) {
  const payload = { tool: wireTool(tool), args: { command } };
  if (cwd) payload.cwd = cwd;
  return spawnRvHook("opencode", JSON.stringify(payload));
}

function consultRvSpend(command, cwd, tool) {
  const payload = { tool: wireTool(tool), args: { command }, hostAsk: "spend" };
  if (cwd) payload.cwd = cwd;
  return spawnRvHook("opencode", JSON.stringify(payload));
}

function wireTool(tool) {
  return tool === "session.shell" ? "session.shell" : "bash";
}

function spawnRvHook(host, stdin) {
  return new Promise((resolve) => {
    let settled = false;
    const done = (value) => {
      if (settled) {
        return;
      }
      settled = true;
      resolve(mapRvHookResult(value));
    };

    let child;
    try {
      child = spawn(RV_BINARY, ["hook", "--host", host], {
        stdio: ["pipe", "pipe", "pipe"],
      });
    } catch (error) {
      done({ error });
      return;
    }

    const chunks = [];
    child.stdout.on("data", (chunk) => {
      chunks.push(chunk);
    });
    child.on("error", (error) => {
      done({ error });
    });

    const timer = setTimeout(() => {
      child.kill("SIGKILL");
      done({ timedOut: true });
    }, RV_HOOK_TIMEOUT_MS);

    child.on("close", (code) => {
      clearTimeout(timer);
      done({
        stdout: Buffer.concat(chunks).toString("utf8"),
        exitCode: code,
      });
    });

    try {
      child.stdin.end(stdin, "utf8");
    } catch (error) {
      done({ error });
    }
  });
}

function mapRvHookResult(value) {
  if (value.error && value.error.code === "ENOENT") {
    return { action: "block", reason: "rv missing" };
  }
  if (value.error || value.timedOut) {
    return { action: "block", reason: "rv failed" };
  }
  const stdout = value.stdout ?? "";
  const trimmed = stdout.trim();
  if (trimmed.length > 0) {
    try {
      const parsed = JSON.parse(trimmed);
      if (parsed && parsed.decision === "ask") {
        return {
          action: "ask",
          reason: typeof parsed.reason === "string" ? parsed.reason : "",
          rule: typeof parsed.rule === "string" ? parsed.rule : undefined,
          next: typeof parsed.next === "string" ? parsed.next : undefined,
        };
      }
      if (parsed && parsed.decision === "deny") {
        const unlockable = typeof parsed.rule === "string" && parsed.rule.length > 0;
        return {
          action: unlockable ? "ask" : "block",
          reason: typeof parsed.reason === "string" ? parsed.reason : "",
          rule: typeof parsed.rule === "string" ? parsed.rule : undefined,
          next: typeof parsed.next === "string" ? parsed.next : undefined,
        };
      }
    } catch {
      // non-JSON from a started rv is a failure, not allow
    }
    return { action: "block", reason: "rv failed" };
  }
  if (value.exitCode === 0) {
    return { action: "allow" };
  }
  return { action: "block", reason: "rv failed" };
}

function formatToastMessage(mapped, command) {
  const card = cardFromBlock(mapped, command);
  const lines = [];
  const push = (label, value) => {
    if (!value) {
      return;
    }
    lines.push(`${label.padEnd(4)}  ${value}`);
  };
  push("Why", card.summary);
  push("Cmd", card.preview);
  push("Meta", card.rule);
  push("Next", card.nextStep);
  return lines.join("\n").slice(0, 280);
}

function cardFromBlock(mapped, command) {
  const preview = previewCommand(command);
  if (typeof mapped.rule === "string" || typeof mapped.next === "string") {
    let summary = typeof mapped.reason === "string" ? mapped.reason : "";
    if (typeof mapped.rule === "string") {
      summary = summary.split(` (${mapped.rule})`).join("");
    }
    if (typeof mapped.next === "string") {
      summary = summary.split(`. ${mapped.next}`).join("");
    }
    return {
      summary: sanitizeVisibleText(summary) || "Blocked.",
      rule: typeof mapped.rule === "string" ? mapped.rule : undefined,
      nextStep: typeof mapped.next === "string" ? mapped.next : undefined,
      preview,
    };
  }
  return cardFromReason(mapped.reason, preview);
}

function cardFromReason(reason, preview) {
  const cleaned = sanitizeVisibleText(typeof reason === "string" ? reason : "");
  const withRule = cleaned.match(/^(.+?) \(([^)]+)\)\.\s*(.+)$/);
  if (withRule) {
    return {
      summary: withRule[1],
      rule: withRule[2],
      nextStep: withRule[3],
      preview,
    };
  }
  const withNext = cleaned.match(/^(.+?)\.\s+(.+)$/);
  if (withNext) {
    return {
      summary: withNext[1],
      nextStep: withNext[2],
      preview,
    };
  }
  return {
    summary: cleaned || "Blocked.",
    preview,
  };
}

function sanitizeVisibleText(value) {
  return String(value ?? "")
    .replace(/\s+/g, " ")
    .trim();
}

function previewCommand(command) {
  const text = sanitizeVisibleText(command);
  if (text.length <= RV_CMD_PREVIEW) {
    return text;
  }
  return `${text.slice(0, RV_CMD_PREVIEW - 3)}...`;
}

async function showBlockToast(ctx, mapped, command) {
  const payload = {
    title: RV_TOAST_TITLE,
    message: formatToastMessage(mapped, command),
    variant: "error",
    duration: 8000,
  };
  const toastPromise = invokeShowToast(ctx, payload);
  void toastPromise.catch(() => undefined);
  let timer;
  try {
    await Promise.race([
      toastPromise,
      new Promise((_, reject) => {
        timer = setTimeout(() => reject(new Error("toast timeout")), RV_TOAST_TIMEOUT_MS);
      }),
    ]);
  } catch {
    // Chrome failed; tool.execute.before still throws.
  } finally {
    if (timer !== undefined) {
      clearTimeout(timer);
    }
  }
}

async function invokeShowToast(ctx, payload) {
  const tui = ctx && ctx.client && ctx.client.tui;
  if (!tui) {
    return;
  }
  const showToast =
    typeof tui.showToast === "function" ? tui.showToast.bind(tui) : undefined;
  if (typeof showToast !== "function") {
    return;
  }
  try {
    const wrapped = await showToast({ body: payload });
    if (wrapped && wrapped.error) {
      await showToast(payload);
    }
  } catch {
    await showToast(payload);
  }
}
