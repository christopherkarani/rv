import { spawn } from "node:child_process";

const RV_BINARY = "__RV_BINARY__";
const RV_HOOK_TIMEOUT_MS = 5000;
const RV_TOAST_TIMEOUT_MS = 1500;
const RV_TOAST_TITLE = "RV · Blocked";
const RV_CMD_PREVIEW = 96;

export const RvGuard = async (ctx) => {
  return {
    "tool.execute.before": async (input, output) => {
      if (input.tool !== "bash") {
        return;
      }
      const command = output.args && output.args.command;
      if (typeof command !== "string" || command.length === 0) {
        return;
      }
      const mapped = await consultRv(command);
      if (mapped.action === "block") {
        await showBlockToast(ctx, mapped, command);
        throw new Error(mapped.reason);
      }
    },
  };
};

function consultRv(command) {
  const stdin = JSON.stringify({
    tool: "bash",
    args: { command },
  });
  return spawnRvHook("opencode", stdin);
}

function spawnRvHook(host, stdin) {
  return new Promise((resolve) => {
    let settled = false;
    const done = (value) => {
      if (settled) {
        return;
      }
      settled = true;
      resolve(mapRvHookResult(value));
    };

    let child;
    try {
      child = spawn(RV_BINARY, ["hook", "--host", host], {
        stdio: ["pipe", "pipe", "pipe"],
      });
    } catch (error) {
      done({ error });
      return;
    }

    const chunks = [];
    child.stdout.on("data", (chunk) => {
      chunks.push(chunk);
    });
    child.on("error", (error) => {
      done({ error });
    });

    const timer = setTimeout(() => {
      child.kill("SIGKILL");
      done({ timedOut: true });
    }, RV_HOOK_TIMEOUT_MS);

    child.on("close", (code) => {
      clearTimeout(timer);
      done({
        stdout: Buffer.concat(chunks).toString("utf8"),
        exitCode: code,
      });
    });

    try {
      child.stdin.end(stdin, "utf8");
    } catch (error) {
      done({ error });
    }
  });
}

function mapRvHookResult(value) {
  if (value.error && value.error.code === "ENOENT") {
    return { action: "block", reason: "rv missing" };
  }
  if (value.error || value.timedOut) {
    return { action: "block", reason: "rv failed" };
  }
  const stdout = value.stdout ?? "";
  const trimmed = stdout.trim();
  if (trimmed.length > 0) {
    try {
      const parsed = JSON.parse(trimmed);
      if (parsed && parsed.decision === "deny") {
        return {
          action: "block",
          reason: typeof parsed.reason === "string" ? parsed.reason : "",
          rule: typeof parsed.rule === "string" ? parsed.rule : undefined,
          next: typeof parsed.next === "string" ? parsed.next : undefined,
        };
      }
    } catch {
      // non-JSON from a started rv is a failure, not allow
    }
    return { action: "block", reason: "rv failed" };
  }
  if (value.exitCode === 0) {
    return { action: "allow" };
  }
  return { action: "block", reason: "rv failed" };
}

function formatToastMessage(mapped, command) {
  const card = cardFromBlock(mapped, command);
  const lines = [];
  const push = (label, value) => {
    if (!value) {
      return;
    }
    lines.push(`${label.padEnd(4)}  ${value}`);
  };
  push("Why", card.summary);
  push("Cmd", card.preview);
  push("Meta", card.rule);
  push("Next", card.nextStep);
  return lines.join("\n").slice(0, 280);
}

function cardFromBlock(mapped, command) {
  const preview = previewCommand(command);
  if (typeof mapped.rule === "string" || typeof mapped.next === "string") {
    let summary = typeof mapped.reason === "string" ? mapped.reason : "";
    if (typeof mapped.rule === "string") {
      summary = summary.split(` (${mapped.rule})`).join("");
    }
    if (typeof mapped.next === "string") {
      summary = summary.split(`. ${mapped.next}`).join("");
    }
    return {
      summary: sanitizeVisibleText(summary) || "Blocked.",
      rule: typeof mapped.rule === "string" ? mapped.rule : undefined,
      nextStep: typeof mapped.next === "string" ? mapped.next : undefined,
      preview,
    };
  }
  return cardFromReason(mapped.reason, preview);
}

function cardFromReason(reason, preview) {
  const cleaned = sanitizeVisibleText(typeof reason === "string" ? reason : "");
  const withRule = cleaned.match(/^(.+?) \(([^)]+)\)\.\s*(.+)$/);
  if (withRule) {
    return {
      summary: withRule[1],
      rule: withRule[2],
      nextStep: withRule[3],
      preview,
    };
  }
  const withNext = cleaned.match(/^(.+?)\.\s+(.+)$/);
  if (withNext) {
    return {
      summary: withNext[1],
      nextStep: withNext[2],
      preview,
    };
  }
  return {
    summary: cleaned || "Blocked.",
    preview,
  };
}

function sanitizeVisibleText(value) {
  return String(value ?? "")
    .replace(/\s+/g, " ")
    .trim();
}

function previewCommand(command) {
  const text = sanitizeVisibleText(command);
  if (text.length <= RV_CMD_PREVIEW) {
    return text;
  }
  return `${text.slice(0, RV_CMD_PREVIEW - 3)}...`;
}

async function showBlockToast(ctx, mapped, command) {
  const payload = {
    title: RV_TOAST_TITLE,
    message: formatToastMessage(mapped, command),
    variant: "error",
    duration: 8000,
  };
  const toastPromise = invokeShowToast(ctx, payload);
  void toastPromise.catch(() => undefined);
  let timer;
  try {
    await Promise.race([
      toastPromise,
      new Promise((_, reject) => {
        timer = setTimeout(() => reject(new Error("toast timeout")), RV_TOAST_TIMEOUT_MS);
      }),
    ]);
  } catch {
    // Chrome failed; tool.execute.before still throws.
  } finally {
    if (timer !== undefined) {
      clearTimeout(timer);
    }
  }
}

async function invokeShowToast(ctx, payload) {
  const tui = ctx && ctx.client && ctx.client.tui;
  if (!tui) {
    return;
  }
  const showToast =
    typeof tui.showToast === "function" ? tui.showToast.bind(tui) : undefined;
  if (typeof showToast !== "function") {
    return;
  }
  try {
    await showToast(payload);
  } catch {
    await showToast({ body: payload });
  }
}
