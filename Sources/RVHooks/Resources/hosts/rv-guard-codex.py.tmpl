"""RV destructive-command guard for Codex Bash.

Codex PreToolUse command hook. Live deny is the older official honor path
``{"decision":"block","reason":...}`` on stdout, the blocking reason on
stderr, and process exit 2. Exit 2 with empty or whitespace-only stderr
fail-opens the tool the same way as no stderr.
Do not emit Claude permission deny JSON as the live deny. Missing rv /
timeout / crash / non-JSON fail closed the same way. Never emit leftover
Ask JSON.
"""

import json
import subprocess
import sys
import unicodedata

RV_BINARY = "__RV_BINARY__"
RV_HOOK_TIMEOUT_S = 15

# Every block says what broke and what to run; never a bare "rv failed".
_NO_REASON = "rv blocked this action without giving a reason. Run `rv doctor`."
_BAD_REQUEST = "rv could not read the hook request from the host. Run `rv doctor`."
_ADAPTER_ERROR = "The rv hook adapter hit an unexpected error. Run `rv doctor`."


def _missing_reason():
    return "rv is not installed at %s. Reinstall rv or run `rv setup`." % RV_BINARY


def _spawn_failed_reason(error):
    why = getattr(error, "strerror", None) or error.__class__.__name__
    return "rv at %s could not be started: %s. Run `rv doctor`." % (RV_BINARY, why)


def _timeout_reason():
    return (
        "rv did not answer within %gs; the daemon may be busy or stopped. Run `rv doctor`."
        % RV_HOOK_TIMEOUT_S
    )


def _bad_output_reason(exit_code):
    return "rv exited with code %s without a usable decision. Run `rv doctor`." % exit_code


def _reject_duplicate_keys(pairs):
    # A repeated key reads as its LAST value here and in Node, but as its
    # FIRST in other parsers: refuse the document instead of picking one.
    seen = {}
    for key, value in pairs:
        if key in seen:
            raise ValueError("duplicate JSON key")
        seen[key] = value
    return seen


def _wire_key(name):
    # Same key as rv's HookWireName: case-folded, without whitespace,
    # control or format characters, "_" or "-".
    kept = []
    for ch in name:
        if ch in "_-" or ch.isspace():
            continue
        if unicodedata.category(ch) in ("Cc", "Cf", "Zs", "Zl", "Zp"):
            continue
        kept.append(ch)
    return "".join(kept).lower()


def _canonical(name, known):
    # A near-variant of a guarded spelling ("bash", "Bash ") reads as it,
    # so it is still sent to rv. Non-strings go to rv, which refuses them.
    if not isinstance(name, str):
        return name
    if name in known:
        return name
    key = _wire_key(name)
    if not key:
        return name
    for spelling in known:
        if _wire_key(spelling) == key:
            return spelling
    return name


def _is_pre_tool_event(event, pre_tool_event):
    # rv is registered for the pre-tool event only: a missing, blank or
    # non-string event is that event, never a reason to skip rv.
    if not isinstance(event, str) or not _wire_key(event):
        return True
    return _canonical(event, (pre_tool_event,)) == pre_tool_event


def main():
    try:
        raw = sys.stdin.read()
        mapped = _guard(raw)
        if mapped["action"] == "block":
            _emit_block(mapped["reason"])
        return
    except Exception:
        _emit_block(_ADAPTER_ERROR)


def _guard(raw):
    envelope = _parse(raw)
    if envelope is None:
        return {"action": "block", "reason": _BAD_REQUEST}
    if not _is_pre_tool_event(envelope.get("hook_event_name"), "PreToolUse"):
        return {"action": "allow"}
    tool = _canonical(envelope.get("tool_name"), ("Bash",))
    if isinstance(tool, str) and tool != "Bash":
        return {"action": "allow"}
    mapped = _spawn_rv_hook("codex", raw)
    if mapped["action"] == "block":
        return mapped
    return {"action": "allow"}


def _parse(raw):
    try:
        parsed = json.loads(raw, object_pairs_hook=_reject_duplicate_keys)
    except (ValueError, TypeError, RecursionError):
        return None
    if isinstance(parsed, dict):
        return parsed
    return None


def _spawn_rv_hook(host, stdin):
    try:
        completed = subprocess.run(
            [RV_BINARY, "hook", "--host", host],
            input=stdin,
            capture_output=True,
            text=True,
            timeout=RV_HOOK_TIMEOUT_S,
        )
    except FileNotFoundError:
        return {"action": "block", "reason": _missing_reason()}
    except subprocess.TimeoutExpired:
        return {"action": "block", "reason": _timeout_reason()}
    except OSError as error:
        return {"action": "block", "reason": _spawn_failed_reason(error)}
    return _map_rv_hook_result(completed.stdout, completed.returncode)


def _map_rv_hook_result(stdout, exit_code):
    trimmed = (stdout or "").strip()
    if trimmed:
        try:
            parsed = json.loads(trimmed)
            if isinstance(parsed, dict) and parsed.get("decision") in ("block", "deny"):
                return {
                    "action": "block",
                    "reason": _blocking_reason(parsed.get("reason")),
                }
        except (ValueError, TypeError):
            pass
        return {"action": "block", "reason": _bad_output_reason(exit_code)}
    if exit_code == 0:
        return {"action": "allow"}
    return {"action": "block", "reason": _bad_output_reason(exit_code)}


def _blocking_reason(reason):
    if isinstance(reason, str):
        text = reason.strip()
        if text:
            return text
    return _NO_REASON


def _emit_block(reason):
    text = _blocking_reason(reason)
    sys.stdout.write(
        json.dumps({"decision":"block","reason":text}, separators=(",", ":")) + "\n"
    )
    sys.stderr.write(text + "\n")
    sys.exit(2)


if __name__ == "__main__":
    main()
