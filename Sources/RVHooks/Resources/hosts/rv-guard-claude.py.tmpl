"""RV destructive-command guard for Claude Bash.

Claude PreToolUse command hook. Step 8B: host dialogs never authorize.
Approval happens in RVOperatorUI (or `rv allow-once`); the agent retries
afterwards. Never emit permissionDecision ask (leftover-ask-as-permit:
host Allow would run the tool with no RV approval). Extra
hookSpecificOutput keys can fail-open a deny — wrapper-owned deny JSON
uses documented fields only. Allow is empty stdout exit 0. Deny is always
a documented Claude permissionDecision deny JSON exit 0 (never passthrough
rv stdout).
"""

import json
import subprocess
import sys
import unicodedata

RV_BINARY = "__RV_BINARY__"
RV_HOOK_TIMEOUT_S = 15

# Every block says what broke and what to run; never a bare "rv failed".
_NO_REASON = "rv blocked this action without giving a reason. Run `rv doctor`."
_BAD_REQUEST = "rv could not read the hook request from the host. Run `rv doctor`."
_ADAPTER_ERROR = "The rv hook adapter hit an unexpected error. Run `rv doctor`."


def _missing_reason():
    return "rv is not installed at %s. Reinstall rv or run `rv setup`." % RV_BINARY


def _spawn_failed_reason(error):
    why = getattr(error, "strerror", None) or error.__class__.__name__
    return "rv at %s could not be started: %s. Run `rv doctor`." % (RV_BINARY, why)


def _timeout_reason():
    return (
        "rv did not answer within %gs; the daemon may be busy or stopped. Run `rv doctor`."
        % RV_HOOK_TIMEOUT_S
    )


def _bad_output_reason(exit_code):
    return "rv exited with code %s without a usable decision. Run `rv doctor`." % exit_code


def _reject_duplicate_keys(pairs):
    # A repeated key reads as its LAST value here and in Node, but as its
    # FIRST in other parsers: refuse the document instead of picking one.
    seen = {}
    for key, value in pairs:
        if key in seen:
            raise ValueError("duplicate JSON key")
        seen[key] = value
    return seen


def _wire_key(name):
    # Same key as rv's HookWireName: case-folded, without whitespace,
    # control or format characters, "_" or "-".
    kept = []
    for ch in name:
        if ch in "_-" or ch.isspace():
            continue
        if unicodedata.category(ch) in ("Cc", "Cf", "Zs", "Zl", "Zp"):
            continue
        kept.append(ch)
    return "".join(kept).lower()


def _canonical(name, known):
    # A near-variant of a guarded spelling ("bash", "Bash ") reads as it,
    # so it is still sent to rv. Non-strings go to rv, which refuses them.
    if not isinstance(name, str):
        return name
    if name in known:
        return name
    key = _wire_key(name)
    if not key:
        return name
    for spelling in known:
        if _wire_key(spelling) == key:
            return spelling
    return name


def _is_pre_tool_event(event, pre_tool_event):
    # rv is registered for the pre-tool event only: a missing, blank or
    # non-string event is that event, never a reason to skip rv.
    if not isinstance(event, str) or not _wire_key(event):
        return True
    return _canonical(event, (pre_tool_event,)) == pre_tool_event


def main():
    try:
        raw = sys.stdin.read()
        mapped = _guard(raw)
        if mapped["action"] == "allow":
            return
        _emit_deny(mapped)
        return
    except Exception:
        _emit_deny({"action": "block", "reason": _ADAPTER_ERROR})


_FILE_TOOLS = (
    "Read",
    "Edit",
    "Write",
    "read_file",
    "edit_file",
    "write_file",
    "Grep",
    "Glob",
    "NotebookEdit",
    "MultiEdit",
)


def _guard(raw):
    envelope = _parse(raw)
    if envelope is None:
        return {"action": "block", "reason": _BAD_REQUEST}
    if not _is_pre_tool_event(envelope.get("hook_event_name"), "PreToolUse"):
        return {"action": "allow"}
    tool = _canonical(envelope.get("tool_name"), ("Bash",) + _FILE_TOOLS)
    if tool in _FILE_TOOLS or not isinstance(tool, str):
        mapped = _spawn_rv_hook("claude", raw)
        if mapped["action"] == "allow":
            return mapped
        if mapped["action"] == "ask":
            return {
                "action": "block",
                "reason": _blocking_reason(mapped.get("reason")),
            }
        return mapped
    if tool != "Bash":
        return {"action": "allow"}
    mapped = _spawn_rv_hook("claude", raw)
    if mapped["action"] == "allow":
        return mapped
    # A legacy `ask` decision blocks like a deny: host dialogs never
    # authorize. The human approves in RVOperatorUI and the agent retries.
    if mapped["action"] == "ask":
        return {
            "action": "block",
            "reason": _blocking_reason(mapped.get("reason")),
        }
    return mapped


def _parse(raw):
    try:
        parsed = json.loads(raw, object_pairs_hook=_reject_duplicate_keys)
    except (ValueError, TypeError, RecursionError):
        return None
    if isinstance(parsed, dict):
        return parsed
    return None


def _spawn_rv_hook(host, stdin):
    try:
        completed = subprocess.run(
            [RV_BINARY, "hook", "--host", host],
            input=stdin,
            capture_output=True,
            text=True,
            timeout=RV_HOOK_TIMEOUT_S,
        )
    except FileNotFoundError:
        return {"action": "block", "reason": _missing_reason()}
    except subprocess.TimeoutExpired:
        return {"action": "block", "reason": _timeout_reason()}
    except OSError as error:
        return {"action": "block", "reason": _spawn_failed_reason(error)}
    return _map_rv_hook_result(completed.stdout, completed.returncode)


def _map_rv_hook_result(stdout, exit_code):
    trimmed = (stdout or "").strip()
    if trimmed:
        try:
            parsed = json.loads(trimmed)
        except (ValueError, TypeError):
            return {"action": "block", "reason": _bad_output_reason(exit_code)}
        if not isinstance(parsed, dict):
            return {"action": "block", "reason": _bad_output_reason(exit_code)}
        if parsed.get("decision") == "ask":
            return {
                "action": "ask",
                "reason": parsed.get("reason") if isinstance(parsed.get("reason"), str) else "",
            }
        hook = parsed.get("hookSpecificOutput")
        # rv's own native ask (daemon down or slow) blocks like a deny, but
        # carries rv's message: it says what broke and how to repair it.
        if isinstance(hook, dict) and hook.get("permissionDecision") == "ask":
            return {
                "action": "block",
                "reason": _blocking_reason(
                    hook.get("permissionDecisionReason") or parsed.get("systemMessage")
                ),
            }
        if isinstance(hook, dict) and hook.get("permissionDecision") == "deny":
            return {
                "action": "block",
                "reason": _blocking_reason(
                    hook.get("permissionDecisionReason") or parsed.get("systemMessage")
                ),
            }
        if parsed.get("decision") in ("block", "deny"):
            return {
                "action": "block",
                "reason": _blocking_reason(parsed.get("reason")),
            }
        return {"action": "block", "reason": _bad_output_reason(exit_code)}
    if exit_code == 0:
        return {"action": "allow"}
    return {"action": "block", "reason": _bad_output_reason(exit_code)}


def _blocking_reason(reason):
    if isinstance(reason, str):
        text = reason.strip()
        if text:
            return text
    return _NO_REASON


def _emit_deny(mapped):
    text = _blocking_reason(mapped.get("reason") if isinstance(mapped, dict) else None)
    payload = {
        "systemMessage": text,
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": text,
        },
    }
    sys.stdout.write(json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n")
    sys.exit(0)


if __name__ == "__main__":
    main()
