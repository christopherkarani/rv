"""RV destructive-command guard for Claude Bash.

Claude PreToolUse command hook. Step 8B: host dialogs never authorize.
Approval happens in RVOperatorUI (or `rv allow-once`); the agent retries
afterwards. Never emit permissionDecision ask (leftover-ask-as-permit:
host Allow would run the tool with no RV approval). Extra
hookSpecificOutput keys can fail-open a deny — wrapper-owned deny JSON
uses documented fields only. Allow is empty stdout exit 0. Deny is always
a documented Claude permissionDecision deny JSON exit 0 (never passthrough
rv stdout).
"""

import json
import subprocess
import sys

RV_BINARY = "__RV_BINARY__"
RV_HOOK_TIMEOUT_S = 5


def main():
    try:
        raw = sys.stdin.read()
        mapped = _guard(raw)
        if mapped["action"] == "allow":
            return
        _emit_deny(mapped)
        return
    except Exception:
        _emit_deny({"action": "block", "reason": "rv failed"})


_FILE_TOOLS = ("Read", "Edit", "Write", "read_file", "edit_file", "write_file")


def _guard(raw):
    envelope = _parse(raw)
    if envelope is None:
        return {"action": "block", "reason": "rv failed"}
    if envelope.get("hook_event_name") != "PreToolUse":
        return {"action": "allow"}
    tool = envelope.get("tool_name")
    if tool in _FILE_TOOLS:
        mapped = _spawn_rv_hook("claude", raw)
        if mapped["action"] == "allow":
            return mapped
        if mapped["action"] == "ask":
            return {
                "action": "block",
                "reason": _blocking_reason(mapped.get("reason")),
            }
        return mapped
    if tool != "Bash":
        return {"action": "allow"}
    mapped = _spawn_rv_hook("claude", raw)
    if mapped["action"] == "allow":
        return mapped
    # A legacy `ask` decision blocks like a deny: host dialogs never
    # authorize. The human approves in RVOperatorUI and the agent retries.
    if mapped["action"] == "ask":
        return {
            "action": "block",
            "reason": _blocking_reason(mapped.get("reason")),
        }
    return mapped


def _parse(raw):
    try:
        parsed = json.loads(raw)
    except (ValueError, TypeError):
        return None
    if isinstance(parsed, dict):
        return parsed
    return None


def _spawn_rv_hook(host, stdin):
    try:
        completed = subprocess.run(
            [RV_BINARY, "hook", "--host", host],
            input=stdin,
            capture_output=True,
            text=True,
            timeout=RV_HOOK_TIMEOUT_S,
        )
    except FileNotFoundError:
        return {"action": "block", "reason": "rv missing"}
    except (OSError, subprocess.TimeoutExpired):
        return {"action": "block", "reason": "rv failed"}
    return _map_rv_hook_result(completed.stdout, completed.returncode)


def _map_rv_hook_result(stdout, exit_code):
    trimmed = (stdout or "").strip()
    if trimmed:
        try:
            parsed = json.loads(trimmed)
        except (ValueError, TypeError):
            return {"action": "block", "reason": "rv failed"}
        if not isinstance(parsed, dict):
            return {"action": "block", "reason": "rv failed"}
        if parsed.get("decision") == "ask":
            return {
                "action": "ask",
                "reason": parsed.get("reason") if isinstance(parsed.get("reason"), str) else "",
            }
        hook = parsed.get("hookSpecificOutput")
        if isinstance(hook, dict) and hook.get("permissionDecision") == "ask":
            return {"action": "block", "reason": "rv failed"}
        if isinstance(hook, dict) and hook.get("permissionDecision") == "deny":
            return {
                "action": "block",
                "reason": _blocking_reason(
                    hook.get("permissionDecisionReason") or parsed.get("systemMessage")
                ),
            }
        if parsed.get("decision") in ("block", "deny"):
            return {
                "action": "block",
                "reason": _blocking_reason(parsed.get("reason")),
            }
        return {"action": "block", "reason": "rv failed"}
    if exit_code == 0:
        return {"action": "allow"}
    return {"action": "block", "reason": "rv failed"}


def _blocking_reason(reason):
    if isinstance(reason, str):
        text = reason.strip()
        if text:
            return text
    return "rv failed"


def _emit_deny(mapped):
    text = _blocking_reason(mapped.get("reason") if isinstance(mapped, dict) else None)
    payload = {
        "systemMessage": text,
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": text,
        },
    }
    sys.stdout.write(json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n")
    sys.exit(0)


if __name__ == "__main__":
    main()
