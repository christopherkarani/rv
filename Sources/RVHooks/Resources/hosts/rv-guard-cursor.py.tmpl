"""RV destructive-command guard for Cursor shell.

Cursor beforeShellExecution command hook, beforeReadFile, plus preToolUse
Read / Edit / Write / Grep.
Live deny is the official native
honor path ``{"permission":"deny","user_message":...,"agent_message":...}``
on stdout and process exit 0. See https://cursor.com/docs/hooks.md.
Do not emit Claude nested permission JSON. Do not emit Codex
``decision: block`` + exit 2. Do not emit leftover Cursor ask permission.
Missing rv / timeout / crash / non-JSON / empty or whitespace stdout
fail closed the same way. Official allow is ``{"permission":"allow"}``.
``failClosed: true`` on hooks.json so Cursor itself blocks on hook failure.
"""

import json
import subprocess
import sys
import unicodedata

RV_BINARY = "__RV_BINARY__"
RV_HOOK_TIMEOUT_S = 15

# Every block says what broke and what to run; never a bare "rv failed".
_NO_REASON = "rv blocked this action without giving a reason. Run `rv doctor`."
_BAD_REQUEST = "rv could not read the hook request from the host. Run `rv doctor`."
_ADAPTER_ERROR = "The rv hook adapter hit an unexpected error. Run `rv doctor`."


def _missing_reason():
    return "rv is not installed at %s. Reinstall rv or run `rv setup`." % RV_BINARY


def _spawn_failed_reason(error):
    why = getattr(error, "strerror", None) or error.__class__.__name__
    return "rv at %s could not be started: %s. Run `rv doctor`." % (RV_BINARY, why)


def _timeout_reason():
    return (
        "rv did not answer within %gs; the daemon may be busy or stopped. Run `rv doctor`."
        % RV_HOOK_TIMEOUT_S
    )


def _bad_output_reason(exit_code):
    return "rv exited with code %s without a usable decision. Run `rv doctor`." % exit_code


def _reject_duplicate_keys(pairs):
    # A repeated key reads as its LAST value here and in Node, but as its
    # FIRST in other parsers: refuse the document instead of picking one.
    seen = {}
    for key, value in pairs:
        if key in seen:
            raise ValueError("duplicate JSON key")
        seen[key] = value
    return seen


def _wire_key(name):
    # Same key as rv's HookWireName: case-folded, without whitespace,
    # control or format characters, "_" or "-".
    kept = []
    for ch in name:
        if ch in "_-" or ch.isspace():
            continue
        if unicodedata.category(ch) in ("Cc", "Cf", "Zs", "Zl", "Zp"):
            continue
        kept.append(ch)
    return "".join(kept).lower()


def _canonical(name, known):
    # A near-variant of a guarded spelling ("bash", "Bash ") reads as it,
    # so it is still sent to rv. Non-strings go to rv, which refuses them.
    if not isinstance(name, str):
        return name
    if name in known:
        return name
    key = _wire_key(name)
    if not key:
        return name
    for spelling in known:
        if _wire_key(spelling) == key:
            return spelling
    return name


def main():
    try:
        raw = sys.stdin.read()
        mapped = _guard(raw)
        if mapped["action"] == "block":
            _emit_deny(
                mapped["reason"],
                user_message=mapped.get("user_message"),
                agent_message=mapped.get("agent_message"),
            )
        else:
            _emit_allow()
        return
    except Exception:
        _emit_deny(_ADAPTER_ERROR)


_SHELL_TOOLS = ("Shell", "Bash", "shell", "bash")
_FILE_TOOLS = ("Read", "Edit", "Write", "read_file", "edit_file", "write_file", "Grep")


def _guard(raw):
    envelope = _parse(raw)
    if envelope is None:
        return {"action": "block", "reason": _BAD_REQUEST}
    event = envelope.get("hook_event_name") or ""
    if isinstance(event, str) and not _wire_key(event):
        event = ""
    event = _canonical(event, ("beforeShellExecution", "preToolUse", "beforeReadFile"))
    if not isinstance(event, str):
        # Not a string: rv refuses the payload; never skip it.
        pass
    elif event == "preToolUse":
        tool = _canonical(envelope.get("tool_name") or "", _SHELL_TOOLS + _FILE_TOOLS)
        if isinstance(tool, str) and tool not in _SHELL_TOOLS and tool not in _FILE_TOOLS:
            return {"action": "allow"}
    elif event not in ("", "beforeShellExecution", "beforeReadFile"):
        return {"action": "allow"}
    mapped = _spawn_rv_hook("cursor", raw)
    if mapped["action"] == "block":
        return mapped
    return {"action": "allow"}


def _parse(raw):
    try:
        parsed = json.loads(raw, object_pairs_hook=_reject_duplicate_keys)
    except (ValueError, TypeError, RecursionError):
        return None
    if isinstance(parsed, dict):
        return parsed
    return None


def _spawn_rv_hook(host, stdin):
    try:
        completed = subprocess.run(
            [RV_BINARY, "hook", "--host", host],
            input=stdin,
            capture_output=True,
            text=True,
            timeout=RV_HOOK_TIMEOUT_S,
        )
    except FileNotFoundError:
        return {"action": "block", "reason": _missing_reason()}
    except subprocess.TimeoutExpired:
        return {"action": "block", "reason": _timeout_reason()}
    except OSError as error:
        return {"action": "block", "reason": _spawn_failed_reason(error)}
    return _map_rv_hook_result(completed.stdout, completed.returncode)


def _map_rv_hook_result(stdout, exit_code):
    trimmed = (stdout or "").strip()
    if trimmed:
        try:
            parsed = json.loads(trimmed)
            if isinstance(parsed, dict):
                permission = parsed.get("permission")
                if permission == "allow":
                    return {"action": "allow"}
                # rv's own native ask (daemon down or slow) denies like a
                # deny but keeps rv's message, which names the repair.
                if permission in ("ask", "deny"):
                    user = parsed.get("user_message")
                    agent = parsed.get("agent_message")
                    return {
                        "action": "block",
                        "reason": _blocking_reason(user or agent),
                        "user_message": user,
                        "agent_message": agent,
                    }
                decision = parsed.get("decision")
                if decision in ("block", "deny"):
                    return {
                        "action": "block",
                        "reason": _blocking_reason(parsed.get("reason")),
                    }
        except (ValueError, TypeError):
            pass
    return {"action": "block", "reason": _bad_output_reason(exit_code)}


def _blocking_reason(reason):
    if isinstance(reason, str):
        text = reason.strip()
        if text:
            return text
    return _NO_REASON


def _emit_allow():
    sys.stdout.write(json.dumps({"permission": "allow"}, separators=(",", ":")) + "\n")
    sys.exit(0)


def _emit_deny(reason, user_message=None, agent_message=None):
    user = _blocking_reason(user_message or reason)
    agent = _blocking_reason(agent_message or user)
    sys.stdout.write(
        json.dumps(
            {
                "permission": "deny",
                "user_message": user,
                "agent_message": agent,
            },
            separators=(",", ":"),
        )
        + "\n"
    )
    sys.exit(0)


if __name__ == "__main__":
    main()
