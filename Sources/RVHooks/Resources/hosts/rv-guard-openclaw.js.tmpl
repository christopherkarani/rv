import { spawn } from "node:child_process";
import { definePluginEntry } from "openclaw/plugin-sdk/plugin-entry";

const RV_BINARY = "__RV_BINARY__";
const RV_HOOK_TIMEOUT_MS = 5000;
const RV_ASK_TIMEOUT_MS = 120000;
const RV_ASK_HOOK_BUDGET_MS = Math.min(RV_ASK_TIMEOUT_MS + 15_000, 600_000);

export default definePluginEntry({
  id: "rv-guard",
  name: "RV",
  description: "Destructive-command guard for OpenClaw exec.",
  register(api) {
    api.on(
      "before_tool_call",
      async (event, ctx) => {
        if (event.toolName !== "exec") {
          return;
        }
        const toolKind =
          typeof event.toolKind === "string"
            ? event.toolKind
            : ctx && typeof ctx.toolKind === "string"
              ? ctx.toolKind
              : undefined;
        if (toolKind === "code_mode_exec") {
          return;
        }
        const params = event.params && typeof event.params === "object" ? event.params : {};
        const command = params.command;
        const workdir = typeof params.workdir === "string" ? params.workdir : undefined;
        const cwd = pickCwd(workdir);
        const sessionId = firstString(
          ctx && ctx.sessionId,
          event && event.sessionId,
        );
        const sessionKey = firstString(
          ctx && ctx.sessionKey,
          event && event.sessionKey,
        );
        const payload = { toolName: "exec", params: {} };
        if (typeof command === "string") {
          payload.params.command = command;
        }
        if (workdir) {
          payload.params.workdir = workdir;
        }
        if (cwd) {
          payload.cwd = cwd;
        }
        if (sessionId) {
          payload.sessionId = sessionId;
        }
        if (sessionKey) {
          payload.sessionKey = sessionKey;
        }
        if (toolKind) {
          payload.toolKind = toolKind;
        }
        const mapped = await consultRv(payload);
        if (mapped.action === "ask") {
          const allowed = await confirmAsk(mapped, event, ctx, api);
          if (!allowed || isAborted(ctx)) {
            return { block: true, blockReason: mapped.reason };
          }
          const spent = await consultRvSpend(payload);
          if (spent.action !== "allow") {
            const reason =
              typeof spent.reason === "string" && spent.reason.length > 0
                ? spent.reason
                : typeof mapped.reason === "string" && mapped.reason.length > 0
                  ? mapped.reason
                  : "rv failed";
            return { block: true, blockReason: reason };
          }
          return;
        }
        if (mapped.action === "block") {
          return { block: true, blockReason: mapped.reason };
        }
      },
      { matcher: ["exec"], timeoutMs: RV_ASK_HOOK_BUDGET_MS },
    );
  },
});

function firstString(...values) {
  for (const value of values) {
    if (typeof value === "string" && value.length > 0) return value;
  }
  return undefined;
}

function pickCwd(hostCwd) {
  if (typeof hostCwd === "string" && hostCwd.length > 0) return hostCwd;
  try {
    const cwd = process.cwd();
    if (typeof cwd === "string" && cwd.length > 0) return cwd;
  } catch {
    // omit
  }
  return undefined;
}

function consultRv(payload) {
  return spawnRvHook("openclaw", JSON.stringify(payload));
}

function consultRvSpend(payload) {
  const spend = {
    toolName: payload.toolName,
    params: payload.params && typeof payload.params === "object" ? { ...payload.params } : {},
    hostAsk: "spend",
  };
  if (payload.cwd) spend.cwd = payload.cwd;
  if (payload.sessionId) spend.sessionId = payload.sessionId;
  if (payload.sessionKey) spend.sessionKey = payload.sessionKey;
  if (payload.toolKind) spend.toolKind = payload.toolKind;
  return spawnRvHook("openclaw", JSON.stringify(spend));
}

function isAborted(ctx) {
  return Boolean(ctx && ctx.abortSignal && ctx.abortSignal.aborted);
}

async function confirmAsk(mapped, event, ctx, api) {
  if (isAborted(ctx)) return false;
  const env = (process.env.RV_ASK_CONFIRM || "").trim().toLowerCase();
  if (env === "yes") return true;
  if (env === "no") return false;
  try {
    const gateway = api && api.runtime && api.runtime.gateway;
    if (!gateway || typeof gateway.request !== "function") {
      return false;
    }
    if (typeof gateway.isAvailable === "function") {
      const available = await gateway.isAvailable();
      if (available !== true) {
        return false;
      }
    }
    const reason = typeof mapped.reason === "string" ? mapped.reason : "";
    const description = reason.length > 0 ? reason.slice(0, 512) : "Allow this exec tool call once?";
    const requester = ctx && typeof ctx.requester === "object" ? ctx.requester : undefined;
    const requested = await gateway.request(
      "plugin.approval.request",
      {
        pluginId: "rv-guard",
        title: "Allow this command once",
        description,
        severity: "warning",
        allowedDecisions: ["allow-once", "deny"],
        toolName: typeof event.toolName === "string" ? event.toolName : "exec",
        toolCallId: event && event.toolCallId,
        agentId: ctx && ctx.agentId,
        sessionKey: ctx && ctx.sessionKey,
        timeoutMs: RV_ASK_TIMEOUT_MS,
        twoPhase: true,
        turnSourceChannel:
          (ctx && ctx.turnSourceChannel) || (requester && requester.channel) || undefined,
        turnSourceTo: ctx && ctx.turnSourceTo,
        turnSourceAccountId:
          (ctx && ctx.turnSourceAccountId) || (requester && requester.accountId) || undefined,
      },
      { timeoutMs: RV_ASK_TIMEOUT_MS + 10_000, signal: ctx && ctx.abortSignal },
    );
    if (!requested || typeof requested !== "object") {
      return false;
    }
    if (requested.decision === "allow-once") {
      return true;
    }
    if (typeof requested.decision === "string") {
      return false;
    }
    const id = requested.id;
    if (typeof id !== "string" || id.length === 0) {
      return false;
    }
    const waited = await gateway.request(
      "plugin.approval.waitDecision",
      { id },
      { timeoutMs: RV_ASK_TIMEOUT_MS + 10_000, signal: ctx && ctx.abortSignal },
    );
    return Boolean(waited && waited.decision === "allow-once");
  } catch {
    return false;
  }
}

function spawnRvHook(host, stdin) {
  return new Promise((resolve) => {
    let settled = false;
    const done = (value) => {
      if (settled) {
        return;
      }
      settled = true;
      resolve(mapRvHookResult(value));
    };

    let child;
    try {
      child = spawn(RV_BINARY, ["hook", "--host", host], {
        stdio: ["pipe", "pipe", "pipe"],
      });
    } catch (error) {
      done({ error });
      return;
    }

    const chunks = [];
    child.stdout.on("data", (chunk) => {
      chunks.push(chunk);
    });
    child.on("error", (error) => {
      done({ error });
    });

    const timer = setTimeout(() => {
      child.kill("SIGKILL");
      done({ timedOut: true });
    }, RV_HOOK_TIMEOUT_MS);

    child.on("close", (code) => {
      clearTimeout(timer);
      done({
        stdout: Buffer.concat(chunks).toString("utf8"),
        exitCode: code,
      });
    });

    try {
      child.stdin.end(stdin, "utf8");
    } catch (error) {
      done({ error });
    }
  });
}

function mapRvHookResult(value) {
  if (value.error && value.error.code === "ENOENT") {
    return { action: "block", reason: "rv missing" };
  }
  if (value.error || value.timedOut) {
    return { action: "block", reason: "rv failed" };
  }
  const stdout = value.stdout ?? "";
  const trimmed = stdout.trim();
  if (trimmed.length > 0) {
    try {
      const parsed = JSON.parse(trimmed);
      if (parsed && parsed.decision === "ask") {
        return {
          action: "ask",
          reason: typeof parsed.reason === "string" ? parsed.reason : "",
        };
      }
      if (parsed && parsed.decision === "deny") {
        return {
          action: "block",
          reason: typeof parsed.reason === "string" ? parsed.reason : "",
        };
      }
    } catch {
      // non-JSON from a started rv is a failure, not allow
    }
    return { action: "block", reason: "rv failed" };
  }
  if (value.exitCode === 0) {
    return { action: "allow" };
  }
  return { action: "block", reason: "rv failed" };
}
