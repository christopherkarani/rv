import { spawn } from "node:child_process";

const RV_BINARY = "__RV_BINARY__";
const RV_HOOK_TIMEOUT_MS = 5000;
const RV_DECISION_TYPE = "rv-decision";
const RV_BLOCK_WIDGET = "rv-block";
const RV_DISPLAY_BRAND = "RV";
const RV_CMD_PREVIEW = 96;
const MINIMAL_LABEL_WIDTH = 4;
const PLAIN_THEME = {
  fg(_name, text) {
    return text;
  },
};

export default function (pi) {
  try {
    pi.registerMessageRenderer?.(RV_DECISION_TYPE, renderDecisionMessage);
  } catch {
    // Older hosts still deny via { block: true }.
  }

  pi.on("tool_call", async (event, ctx) => {
    if (event.toolName !== "bash") {
      return;
    }
    const command = event.input && event.input.command;
    if (typeof command !== "string" || command.length === 0) {
      return;
    }
    const mapped = await consultRv(command);
    if (mapped.action === "block") {
      showDecision(pi, ctx, cardFromBlock(mapped, command));
      return { block: true, reason: mapped.reason };
    }
    clearWidget(ctx);
  });
}

function showDecision(pi, ctx, card) {
  clearWidget(ctx);
  try {
    if (pi.sendMessage) {
      pi.sendMessage(
        {
          customType: RV_DECISION_TYPE,
          content: buildThemedDecisionLines(card, PLAIN_THEME, 72).join("\n"),
          display: true,
          details: card,
        },
        { triggerTurn: false },
      );
      return;
    }
    showWidget(ctx, card);
  } catch {
    // Chrome failed; tool_call still returns { block: true }.
  }
}

function clearWidget(ctx) {
  try {
    ctx?.ui?.setWidget?.(RV_BLOCK_WIDGET, undefined);
  } catch {
    // ignore
  }
}

function showWidget(ctx, card) {
  if (!ctx?.ui?.setWidget) {
    return;
  }
  ctx.ui.setWidget(RV_BLOCK_WIDGET, buildThemedDecisionLines(card, PLAIN_THEME, 72), {
    placement: "aboveEditor",
  });
}

function renderDecisionMessage(message, _options, theme) {
  const details = message && message.details;
  const card = isDecisionCard(details)
    ? details
    : {
        variant: "block",
        title: RV_DISPLAY_BRAND,
        summary:
          typeof message.content === "string" && message.content.length > 0
            ? message.content
            : "Blocked.",
      };
  return {
    render(width) {
      const lines = buildThemedDecisionLines(card, theme, width);
      return lines.length === 0 ? [""] : lines;
    },
  };
}

function isDecisionCard(value) {
  return Boolean(value && typeof value === "object" && typeof value.summary === "string");
}

function buildThemedDecisionLines(card, theme, width) {
  const fg =
    theme && typeof theme.fg === "function" ? theme.fg.bind(theme) : (_n, t) => t;
  const bold =
    theme && typeof theme.bold === "function" ? theme.bold.bind(theme) : (t) => t;
  const brand = bold(card.title || RV_DISPLAY_BRAND);
  const header = `${fg("error", brand)} ${fg("dim", "· Blocked")}`;
  const lines = [header, ""];
  const n = Number(width);
  const contentWidth = Number.isFinite(n) && n > 0 ? n : 72;
  for (const row of decisionCardRows(card)) {
    lines.push(
      ...formatMinimalRow(row.label, row.value, contentWidth, (lab, val, first) => {
        const labelPart = fg("dim", lab);
        if (!first) {
          return `${lab}${val}`;
        }
        if (row.label === "Cmd") {
          return `${labelPart}${fg("dim", val)}`;
        }
        return `${labelPart}${val}`;
      }),
    );
  }
  return lines;
}

function decisionCardRows(card) {
  const rows = [];
  if (card.summary) {
    rows.push({ label: "Why", value: card.summary });
  }
  if (card.preview) {
    rows.push({ label: "Cmd", value: card.preview });
  }
  if (card.rule) {
    rows.push({ label: "Meta", value: card.rule });
  }
  if (card.nextStep) {
    rows.push({ label: "Next", value: card.nextStep });
  }
  return rows;
}

function cardFromBlock(mapped, command) {
  const preview = previewCommand(command);
  const reason = typeof mapped === "string" ? mapped : mapped && mapped.reason;
  const rule = mapped && typeof mapped === "object" ? mapped.rule : undefined;
  const next = mapped && typeof mapped === "object" ? mapped.next : undefined;
  if (typeof rule === "string" || typeof next === "string") {
    let summary = typeof reason === "string" ? reason : "";
    if (typeof rule === "string") {
      summary = summary.split(` (${rule})`).join("");
    }
    if (typeof next === "string") {
      summary = summary.split(`. ${next}`).join("");
    }
    return {
      variant: "block",
      title: RV_DISPLAY_BRAND,
      summary: sanitizeVisibleText(summary) || "Blocked.",
      rule: typeof rule === "string" ? rule : undefined,
      nextStep: typeof next === "string" ? next : undefined,
      preview,
    };
  }
  return cardFromReason(reason, command, preview);
}

function cardFromReason(reason, command, preview) {
  const cleaned = sanitizeVisibleText(typeof reason === "string" ? reason : "");
  const withRule = cleaned.match(/^(.+?) \(([^)]+)\)\.\s*(.+)$/);
  if (withRule) {
    return {
      variant: "block",
      title: RV_DISPLAY_BRAND,
      summary: withRule[1],
      rule: withRule[2],
      nextStep: withRule[3],
      preview: preview ?? previewCommand(command),
    };
  }
  const withNext = cleaned.match(/^(.+?)\.\s+(.+)$/);
  if (withNext) {
    return {
      variant: "block",
      title: RV_DISPLAY_BRAND,
      summary: withNext[1],
      nextStep: withNext[2],
      preview: preview ?? previewCommand(command),
    };
  }
  return {
    variant: "block",
    title: RV_DISPLAY_BRAND,
    summary: cleaned || "Blocked.",
    preview: preview ?? previewCommand(command),
  };
}

function formatMinimalRow(label, value, width, paint) {
  if (!value) {
    return [];
  }
  const labelCol = label.padEnd(MINIMAL_LABEL_WIDTH);
  const available = Math.max(1, width - MINIMAL_LABEL_WIDTH - 2);
  const wrapped = wrapText(value, available);
  return wrapped.map((line, index) => {
    const prefix = index === 0 ? labelCol : "".padEnd(MINIMAL_LABEL_WIDTH, " ");
    const raw = `${prefix}  ${line}`;
    if (!paint) {
      return raw;
    }
    return paint(prefix, `  ${line}`, index === 0);
  });
}

function wrapText(value, width) {
  const text = sanitizeVisibleText(value);
  if (!text) {
    return [""];
  }
  const words = text.split(/\s+/);
  const lines = [];
  let current = "";
  for (const word of words) {
    if (!current) {
      current = word;
      continue;
    }
    if (`${current} ${word}`.length <= width) {
      current = `${current} ${word}`;
      continue;
    }
    lines.push(current);
    current = word;
  }
  if (current) {
    lines.push(current);
  }
  return lines.flatMap((line) => {
    if (line.length <= width) {
      return [line];
    }
    const chunks = [];
    for (let i = 0; i < line.length; i += width) {
      chunks.push(line.slice(i, i + width));
    }
    return chunks;
  });
}

function sanitizeVisibleText(value) {
  return String(value ?? "")
    .replace(/\s+/g, " ")
    .trim();
}

function previewCommand(command) {
  return truncate(sanitizeVisibleText(command), RV_CMD_PREVIEW);
}

function truncate(value, max) {
  if (value.length <= max) {
    return value;
  }
  return `${value.slice(0, max - 3)}...`;
}

function consultRv(command) {
  const stdin = JSON.stringify({
    toolName: "bash",
    input: { command },
  });
  return spawnRvHook("pi", stdin);
}

function spawnRvHook(host, stdin) {
  return new Promise((resolve) => {
    let settled = false;
    const done = (value) => {
      if (settled) {
        return;
      }
      settled = true;
      resolve(mapRvHookResult(value));
    };

    let child;
    try {
      child = spawn(RV_BINARY, ["hook", "--host", host], {
        stdio: ["pipe", "pipe", "pipe"],
      });
    } catch (error) {
      done({ error });
      return;
    }

    const chunks = [];
    child.stdout.on("data", (chunk) => {
      chunks.push(chunk);
    });
    child.on("error", (error) => {
      done({ error });
    });

    const timer = setTimeout(() => {
      child.kill("SIGKILL");
      done({ timedOut: true });
    }, RV_HOOK_TIMEOUT_MS);

    child.on("close", (code) => {
      clearTimeout(timer);
      done({
        stdout: Buffer.concat(chunks).toString("utf8"),
        exitCode: code,
      });
    });

    try {
      child.stdin.end(stdin, "utf8");
    } catch (error) {
      done({ error });
    }
  });
}

function mapRvHookResult(value) {
  if (value.error && value.error.code === "ENOENT") {
    return { action: "block", reason: "rv missing" };
  }
  if (value.error || value.timedOut) {
    return { action: "block", reason: "rv failed" };
  }
  const stdout = value.stdout ?? "";
  const trimmed = stdout.trim();
  if (trimmed.length > 0) {
    try {
      const parsed = JSON.parse(trimmed);
      if (parsed && parsed.decision === "deny") {
        return {
          action: "block",
          reason: typeof parsed.reason === "string" ? parsed.reason : "",
          rule: typeof parsed.rule === "string" ? parsed.rule : undefined,
          next: typeof parsed.next === "string" ? parsed.next : undefined,
        };
      }
    } catch {
      // non-JSON from a started rv is a failure, not allow
    }
    return { action: "block", reason: "rv failed" };
  }
  if (value.exitCode === 0) {
    return { action: "allow" };
  }
  return { action: "block", reason: "rv failed" };
}
