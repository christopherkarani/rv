<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.rv.evaluate</string>
	<key>MachServices</key>
	<dict>
		<key>dev.rv.evaluate</key>
		<true/>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>@RVD_PATH@</string>
	</array>
	<!-- Always on: started at load and relaunched after any exit, a crash or
	     the clean exit once its binary was replaced (the relaunch runs the
	     upgraded rvd). ThrottleInterval 5 keeps a relaunch inside the hook's
	     8 s budget while bounding a crash loop to one spawn every 5 s. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>EnableTransactions</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
		<string>Background</string>
	</array>
</dict>
</plist>
