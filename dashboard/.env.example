# rv Console configuration. Copy to .env.local for development.

# HMAC key for session cookies. Required in production: 32+ random characters
# (openssl rand -base64 48).
RV_CONSOLE_SECRET=

# Seeds the first admin on start when no user exists. Without these the
# console shows a one-time setup screen instead.
RV_CONSOLE_ADMIN_EMAIL=
RV_CONSOLE_ADMIN_PASSWORD=

# Where the SQLite database lives (mount a volume here in Docker).
RV_CONSOLE_DATA_DIR=./data

# Days of events to keep (default 90).
RV_CONSOLE_RETENTION_DAYS=90

# Public URL used in onboarding snippets, e.g. https://rv-console.example.com
RV_CONSOLE_PUBLIC_URL=

# 1 = seed a synthetic fleet on first start and stream live demo events.
RV_CONSOLE_DEMO=0

# 1 = allow session cookies over plain http (lab installs only).
RV_CONSOLE_INSECURE_COOKIES=0
