# Copy to .env.local for development; set the same names in Vercel for production.

# Supabase project (Settings → API). The publishable key is safe in browsers;
# legacy anon JWT keys also work.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Bypasses row-level security: never expose it to the browser.
# Legacy service_role JWT keys also work.
SUPABASE_SECRET_KEY=sb_secret_...

# Public origin of this app: used in auth redirects and the ingest URLs
# machines receive at enrollment.
APP_URL=https://cloud.example.com

# Bearer secret Vercel Cron sends to /api/cron/prune (daily retention).
CRON_SECRET=generate-with-openssl-rand-hex-32

# Show "Continue with GitHub" on the sign-in page (enable the GitHub
# provider in Supabase Auth first).
NEXT_PUBLIC_AUTH_GITHUB=false
