#!/usr/bin/env bash
# tools/swift-6.4 — put the pinned toolchain first on PATH, then exec swift.
# Eliminates the /usr/bin/swift Xcode-skew trap. See docs/dev/SWIFT.md.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PIN_FILE="$ROOT/.swift-version"
if [[ ! -f "$PIN_FILE" ]]; then
  printf "swift-6.4: missing .swift-version\n" >&2
  exit 1
fi
PIN="$(tr -d '[:space:]' <"$PIN_FILE")"
if [[ -z "$PIN" ]]; then
  printf "swift-6.4: empty .swift-version\n" >&2
  exit 1
fi

# Swiftly / some pkgs install 6.4 as swift-6.4.0-RELEASE.xctoolchain
# while --version reports "Apple Swift version 6.4".
candidates=()
candidates+=("$HOME/Library/Developer/Toolchains/swift-${PIN}-RELEASE.xctoolchain/usr/bin/swift")
case "$PIN" in
  *.*.*) ;;
  *.*)
    candidates+=("$HOME/Library/Developer/Toolchains/swift-${PIN}.0-RELEASE.xctoolchain/usr/bin/swift")
    ;;
esac

SWIFT=""
TOOLCHAIN_BIN=""
for cand in "${candidates[@]}"; do
  if [[ -x "$cand" ]]; then
    SWIFT="$cand"
    TOOLCHAIN_BIN="$(cd "$(dirname "$cand")" && pwd)"
    break
  fi
done

# Escape pin dots so 6.4 cannot match 6<any>4. Token edges still reject 6.40.
PIN_RE="$(printf '%s' "$PIN" | sed 's/\./\\./g')"
if [[ -z "$SWIFT" && "$(uname -s)" == "Linux" ]]; then
  # Official Linux tarball from tools/install-official-swift-linux.sh.
  for cand in "$HOME/.local/share/swift/swift-${PIN}-RELEASE-"*/usr/bin/swift \
              "$HOME/.local/share/swift/swift-${PIN}.0-RELEASE-"*/usr/bin/swift; do
    [[ -x "$cand" ]] || continue
    cand_ver="$("$cand" --version 2>/dev/null | head -n 1 || true)"
    if [[ -n "$cand_ver" ]] && printf '%s\n' "$cand_ver" | grep -Eq "(^|[^0-9])${PIN_RE}([^0-9]|$)"; then
      SWIFT="$cand"
      TOOLCHAIN_BIN="$(cd "$(dirname "$cand")" && pwd)"
      break
    fi
  done
fi
if [[ -z "$SWIFT" || ! -x "$SWIFT" ]]; then
  # PATH fallback is Linux-only. Darwin fail-closes so a missing
  # ~/Library/Developer/Toolchains pin cannot silently use /usr/bin/swift.
  if [[ "$(uname -s)" != "Linux" ]]; then
    printf "swift-6.4: toolchain not found for pin %s\n" "$PIN" >&2
    printf "swift-6.4: looked for swift-%s-RELEASE (and .0) under ~/Library/Developer/Toolchains\n" "$PIN" >&2
    printf "swift-6.4: install Swift %s or fix .swift-version\n" "$PIN" >&2
    exit 1
  fi
  PATH_SWIFT="$(command -v swift 2>/dev/null || true)"
  PATH_VER=""
  if [[ -n "$PATH_SWIFT" && -x "$PATH_SWIFT" ]]; then
    PATH_VER="$("$PATH_SWIFT" --version 2>/dev/null | head -n 1 || true)"
  fi
  if [[ -n "$PATH_VER" ]] && printf '%s\n' "$PATH_VER" | grep -Eq "(^|[^0-9])${PIN_RE}([^0-9]|$)"; then
    SWIFT="$PATH_SWIFT"
    TOOLCHAIN_BIN="$(cd "$(dirname "$PATH_SWIFT")" && pwd)"
  else
    printf "swift-6.4: toolchain not found for pin %s\n" "$PIN" >&2
    if [[ -n "$PATH_VER" ]]; then
      printf "swift-6.4: PATH swift is not %s (%s)\n" "$PIN" "$PATH_VER" >&2
    fi
    printf "swift-6.4: install Swift %s or fix .swift-version\n" "$PIN" >&2
    exit 1
  fi
fi

export PATH="$TOOLCHAIN_BIN:$PATH"
exec "$SWIFT" "$@"
